---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import siteData from '../data/data.json';

const { website, colors } = siteData;
const themeVars = `--color-main-light:${colors.primary};--color-secondary-light:${colors.secondary};--color-main-dark:${colors.primaryDark};--color-secondary-dark:${colors.secondaryDark};--color-accent:${colors.accent};`;

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = `${website.name} | Salón de Eventos en ${website.city}, ${website.province}`,
	description = website.description,
	image = '/images/lodecarlin/salon-exterior.jpg'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageURL = new URL(image, Astro.site ?? Astro.url.origin).href;

const schemaData = {
	'@context': 'https://schema.org',
	'@type': 'EventVenue',
	name: website.name,
	description: website.description,
	url: canonicalURL.href,
	image: imageURL,
	hasMap: website.ubication,
	sameAs: [website.instagram].filter(Boolean),
	address: {
		'@type': 'PostalAddress',
		addressLocality: website.city,
		addressRegion: website.province,
		addressCountry: 'AR'
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Salón de eventos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Parque al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Catering y mesa dulce', value: true }
	]
};
---
<!doctype html>
<html lang="es" style={themeVars} class="bg-main text-secondary">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content={colors.primary} />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Lo de Carlin, salón de eventos Cipolletti, salón de fiestas Cipolletti, cumpleaños Cipolletti, casamientos Cipolletti, aniversarios, capacitaciones, eventos Río Negro, salón con parque Cipolletti" />
		<meta name="geo.region" content="AR-R" />
		<meta name="geo.placename" content={website.city} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:site_name" content={website.name} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />

		<noscript><style>[data-anim],[data-hero]{opacity:1!important}</style></noscript>

		<ClientRouter />
	</head>
	<body class="bg-main text-secondary min-h-screen flex flex-col font-sans antialiased">
		<NavBar />
		<main id="page-transition-root" class="flex-1 flex flex-col">
			<slot />
		</main>
		<Footer />

		<script>
			import '../scripts/animations.ts';
		</script>
	</body>
</html>
