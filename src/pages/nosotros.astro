---
import Layout from '../layouts/Layout.astro';
import { Content, frontmatter } from '../data/aboutAs.md';
import PageHeader from '../components/PageHeader.astro';
import Statement from '../components/Statement.astro';
import Spaces from '../components/Spaces.astro';
import Contact from '../components/Contact.astro';
import InstagramButton from '../components/InstagramButton.astro';
---

<Layout title={frontmatter.title} description={frontmatter.description}>
	<PageHeader
		index="04"
		eyebrow="Nosotros"
		title="Un lugar para | celebrar lo importante."
		images={[
			{ src: '/images/lodecarlin/salon-exterior.jpg', alt: 'Frente del salón entre álamos' },
			{ src: '/images/lodecarlin/parque.jpg', alt: 'Parque de Lo de Carlin al atardecer' },
			{ src: '/images/lodecarlin/catering.jpg', alt: 'Mesa dulce de un evento' },
		]}
	/>

	<section class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-8 sm:py-24">
		<div class="grid gap-12 lg:grid-cols-12">
			<div class="lg:col-span-4">
				<div data-anim="clip" class="sticky top-28 overflow-hidden rounded-[1.25rem]">
					<img src="/images/lodecarlin/salon-interior.jpg" alt="Salón de Lo de Carlin ambientado" loading="lazy" class="aspect-[4/5] w-full object-cover" />
				</div>
			</div>
			<article data-anim="up" class="lg:col-span-7 lg:col-start-6 [&_h1]:hidden [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_p]:mt-5 [&_p]:text-lg [&_p]:leading-relaxed [&_p]:text-secondary/75 [&_strong]:font-semibold [&_strong]:text-secondary">
				<Content />
			</article>
		</div>
	</section>

	<Statement text="Nos gusta pensar que cada festejo es un poco nuestro también." cta={{ href: '/reservar', label: 'Reservá tu fecha' }} />
	<Spaces cta />
	<Contact />
	<InstagramButton />
</Layout>
