---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/data.json';
import PageHeader from '../components/PageHeader.astro';
import Location from '../components/Location.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';

const { website } = siteData;

const channels = [
	{ label: 'Cuestionario de reserva', value: 'Armá tu consulta en 1 minuto', href: '/reservar', external: false },
	{ label: 'Instagram', value: website.instagramHandle, href: website.instagram, external: true },
	{ label: 'Mensaje directo', value: 'Reservas por MD', href: website.instagramDM, external: true },
	{ label: 'Ubicación', value: `${website.city}, ${website.province}`, href: website.ubication, external: true },
];
---

<Layout title={`Contacto | ${website.name}`} description={`Consultá disponibilidad y reservá tu fecha en ${website.name}, ${website.city}, ${website.province}. Reservas por mensaje directo en Instagram.`}>
	<PageHeader
		index="05"
		eyebrow="Contacto"
		title="Hablemos de | tu evento."
		description="Elegí el canal que te quede más cómodo. Respondemos todas las consultas por mensaje directo."
	/>

	<section class="mx-auto w-full max-w-7xl px-4 sm:px-8">
		<div data-anim-stagger class="grid gap-px overflow-hidden rounded-[1.25rem] bg-secondary/10 sm:grid-cols-2 lg:grid-cols-4">
			{channels.map((c) => (
				<a
					data-anim="up"
					href={c.href}
					target={c.external ? '_blank' : undefined}
					rel={c.external ? 'noopener noreferrer' : undefined}
					class="group flex min-h-48 flex-col justify-between bg-main p-7 transition-colors duration-500 hover:bg-secondary hover:text-main"
				>
					<span class="text-xs font-medium uppercase tracking-[0.25em] opacity-60">{c.label}</span>
					<span class="flex items-end justify-between gap-4">
						<span class="font-display text-xl font-bold">{c.value}</span>
						<svg class="h-5 w-5 shrink-0 transition-transform duration-500 group-hover:-translate-y-1 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0H8m9 0v9" /></svg>
					</span>
				</a>
			))}
		</div>
	</section>

	<Location />
	<Faq />
	<Contact />
</Layout>
