---
import Layout from '../layouts/Layout.astro';
import { Content, frontmatter } from '../data/aboutAs.md';
import siteData from '../data/data.json';
import WhatsappButton from '../components/WhatsAppButton.astro';
import Highlights from '../components/Highlights.astro';
import FourReasons from '../components/FourReasons.astro';
import SalonAmenities from '../components/SalonAmenities.astro';

const { website } = siteData;
---
<Layout title={frontmatter.title} description={frontmatter.description}>
    <main class="animate-fade-in-up py-10 px-6 sm:px-12 md:px-16 bg-white border border-black/15 w-11/12 lg:w-3/4 max-w-5xl mx-auto mt-8 text-black shadow-sm [&_h1]:font-cinzel [&_h1]:text-3xl [&_h1]:sm:text-5xl [&_h1]:font-light [&_h1]:text-black [&_h1]:uppercase [&_h1]:tracking-tight [&_h2]:font-cinzel [&_h2]:text-xl [&_h2]:sm:text-2xl [&_h2]:font-normal [&_h2]:mt-10 [&_h2]:text-black [&_h2]:uppercase [&_p]:mt-4 [&_p]:text-neutral-700 [&_p]:font-light [&_p]:leading-relaxed [&_blockquote]:border-l-2 [&_blockquote]:border-[#261B14] [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:my-6 [&_blockquote]:text-black [&_blockquote]:bg-neutral-50 [&_blockquote]:py-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mt-4 [&_ul]:space-y-2 [&_ul]:text-neutral-700 [&_ul]:font-light [&_hr]:my-8 [&_hr]:border-black/15">
		<Content />
	</main>
	<FourReasons />
	<SalonAmenities />
	<Highlights />
	<WhatsappButton hrefWhs={`https://api.whatsapp.com/send?phone=${encodeURIComponent(website.telephone)}&text=${encodeURIComponent('¡Hola Malabar Eventos! Me gustaría coordinar una visita para conocer las instalaciones del salón en Tandil.')}`} floating />
</Layout>