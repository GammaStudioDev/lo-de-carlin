---
import Layout from '../../layouts/Layout.astro';
import siteData from '../../data/data.json';
import { products as allProducts } from '../../data/products.json';
import Contact from '../../components/Contact.astro';
import InstagramButton from '../../components/InstagramButton.astro';

export function getStaticPaths() {
	return allProducts.map((product) => ({
		params: { id: String(product.id) },
		props: { product }
	}));
}

const { website } = siteData;
const { product } = Astro.props;
const others = allProducts.filter((p) => p.id !== product.id).slice(0, 3);

const pageURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const productSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: `${product.name} en ${website.name}`,
	description: product.description,
	image: product.images.map((img) => new URL(img, Astro.site ?? Astro.url.origin).href),
	url: pageURL,
	areaServed: `${website.city}, ${website.province}`,
	provider: {
		'@type': 'EventVenue',
		name: website.name,
		address: {
			'@type': 'PostalAddress',
			addressLocality: website.city,
			addressRegion: website.province,
			addressCountry: 'AR'
		}
	}
};
---

<Layout title={`${product.name} en ${website.city} | ${website.name}`} description={product.description} image={product.images[0]}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />

	<section class="mx-auto w-full max-w-7xl px-4 pt-10 sm:px-8 sm:pt-16">
		<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-secondary/55">
			<a href="/" class="hover:text-secondary">Inicio</a>
			<span>/</span>
			<a href="/eventos" class="hover:text-secondary">Eventos</a>
			<span>/</span>
			<span class="text-secondary">{product.name}</span>
		</nav>

		<div class="mt-8 grid items-end gap-8 lg:grid-cols-12">
			<h1 class="font-display text-5xl font-extrabold tracking-tight text-secondary sm:text-7xl lg:col-span-7" transition:name={`product-name-${product.id}`}>
				{product.name}
			</h1>
			<p class="text-lg leading-relaxed text-secondary/75 lg:col-span-5">{product.description}</p>
		</div>

		<!-- Galería -->
		<div id="product-gallery" data-images={JSON.stringify(product.images)} class="mt-12">
			<div class="relative overflow-hidden rounded-2xl bg-tertiary">
				<img
					id="product-main-image"
					src={product.images[0]}
					alt={product.name}
					transition:name={`product-image-${product.id}`}
					class="aspect-[4/3] w-full object-cover transition-opacity duration-300 md:aspect-[16/8]"
				/>
				{product.images.length > 1 && (
					<div class="absolute bottom-4 right-4 flex gap-2">
						<button type="button" id="gallery-prev" aria-label="Foto anterior" class="flex h-11 w-11 items-center justify-center rounded-full bg-main/90 text-secondary backdrop-blur transition hover:bg-main">
							<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
						</button>
						<button type="button" id="gallery-next" aria-label="Foto siguiente" class="flex h-11 w-11 items-center justify-center rounded-full bg-main/90 text-secondary backdrop-blur transition hover:bg-main">
							<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" /></svg>
						</button>
					</div>
				)}
			</div>
			{product.images.length > 1 && (
				<div class="mt-3 grid grid-cols-3 gap-3 sm:gap-4">
					{product.images.map((img, i) => (
						<button
							type="button"
							class="gallery-thumb overflow-hidden rounded-xl opacity-60 transition-opacity hover:opacity-100 data-[active=true]:opacity-100"
							data-index={i}
							data-active={i === 0 ? 'true' : 'false'}
							aria-label={`Ver foto ${i + 1}`}
						>
							<img src={img} alt="" loading="lazy" class="aspect-[16/9] w-full object-cover" />
						</button>
					))}
				</div>
			)}
		</div>
	</section>

	<!-- Qué incluye -->
	{product.features && product.features.length > 0 && (
		<section class="mx-auto w-full max-w-7xl px-4 py-24 sm:px-8">
			<div class="grid gap-12 lg:grid-cols-12">
				<div class="lg:col-span-4">
					<p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.25em] text-secondary/60">
						<span class="h-px w-8 bg-secondary/40"></span>
						La propuesta
					</p>
					<h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">Qué incluye</h2>
				</div>
				<ul class="divide-y divide-secondary/10 border-y border-secondary/10 lg:col-span-8">
					{product.features.map((feature, i) => (
						<li data-anim="up" class="flex items-baseline gap-6 py-6">
							<span class="font-display text-sm font-semibold text-secondary/35">{String(i + 1).padStart(2, '0')}</span>
							<span class="text-lg text-secondary">{feature}</span>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<Contact />

	<!-- Otros eventos -->
	<section class="mx-auto w-full max-w-7xl px-4 py-24 sm:px-8">
		<h2 class="font-display text-3xl font-bold tracking-tight">Otros eventos</h2>
		<div class="mt-10 grid gap-5 sm:grid-cols-3">
			{others.map((p) => (
				<a href={`/productView/${p.id}`} class="group block">
					<div class="overflow-hidden rounded-2xl">
						<img src={p.images[0]} alt={p.name} loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
					</div>
					<p class="mt-4 inline-flex items-center gap-2 font-display text-xl font-semibold">
						{p.name}
						<svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
					</p>
				</a>
			))}
		</div>
	</section>

	<InstagramButton />
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
		const gallery = document.getElementById('product-gallery');
		const main = document.getElementById('product-main-image');
		if (!gallery || !(main instanceof HTMLImageElement)) return;

		let images: string[] = [];
		try {
			images = JSON.parse(gallery.dataset.images || '[]');
		} catch {
			return;
		}
		if (images.length < 2) return;

		const thumbs = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-thumb'));
		let current = 0;

		const show = (index: number) => {
			current = (index + images.length) % images.length;
			main.style.opacity = '0';
			setTimeout(() => {
				main.src = images[current];
				main.style.opacity = '1';
			}, 150);
			thumbs.forEach((t, i) => t.setAttribute('data-active', String(i === current)));
		};

		thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.index || 0))));
		document.getElementById('gallery-prev')?.addEventListener('click', () => show(current - 1));
		document.getElementById('gallery-next')?.addEventListener('click', () => show(current + 1));
	});
</script>
