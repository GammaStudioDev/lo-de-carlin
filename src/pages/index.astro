---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Statement from '../components/Statement.astro';
import Spaces from '../components/Spaces.astro';
import Category from '../components/Category.astro';
import Gallery from '../components/Gallery.astro';
import Steps from '../components/Steps.astro';
import Contact from '../components/Contact.astro';
import InstagramButton from '../components/InstagramButton.astro';
---

<Layout>
	<Hero />
	<Marquee />
	<Statement cta={{ href: '/nosotros', label: 'Conocé nuestra historia' }} />
	<Spaces cta />
	<Category cta />
	<Gallery cta />
	<Steps />
	<Contact />
	<InstagramButton />
</Layout>
