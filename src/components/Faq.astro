---
import Title from './Title.astro';
import siteData from '../data/data.json';

const { website } = siteData;

const faqs = [
	{ q: '¿Cómo hago una reserva?', a: 'Completá el cuestionario de reserva o escribinos por mensaje directo a ' + website.instagramHandle + '. Te respondemos con disponibilidad y propuesta.' },
	{ q: '¿Puedo visitar el salón antes?', a: 'Sí. Coordinamos una visita para que conozcas el salón y el parque antes de decidir.' },
	{ q: '¿Qué tipos de eventos reciben?', a: 'Cumpleaños, casamientos, aniversarios, capacitaciones y todo tipo de eventos privados.' },
	{ q: '¿Se puede usar el parque?', a: 'Sí, el parque es parte del lugar: ideal para recepciones, ceremonias y fotos al aire libre.' },
	{ q: '¿Tienen catering?', a: 'Coordinamos mesa dulce, torta y bocados según lo que necesite tu evento. Consultanos opciones.' },
];
---

<section class="mx-auto w-full max-w-7xl px-4 py-24 sm:px-8 sm:py-32">
	<div class="grid gap-12 lg:grid-cols-12">
		<div class="lg:col-span-5">
			<Title eyebrow="Preguntas frecuentes" title="Lo que más nos consultan." />
		</div>
		<div data-anim-stagger class="divide-y divide-secondary/10 border-y border-secondary/10 lg:col-span-7">
			{faqs.map((f) => (
				<details data-anim="up" class="group py-6">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-semibold text-secondary [&::-webkit-details-marker]:hidden">
						{f.q}
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-secondary/20 transition-transform duration-500 group-open:rotate-45">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
						</span>
					</summary>
					<p class="mt-4 max-w-xl leading-relaxed text-secondary/70">{f.a}</p>
				</details>
			))}
		</div>
	</div>
</section>
