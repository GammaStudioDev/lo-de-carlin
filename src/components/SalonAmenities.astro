---
import siteData from '../data/data.json';

const { website } = siteData;
const defaultWhatsapp = `https://api.whatsapp.com/send?phone=${encodeURIComponent(website.telephone)}&text=${encodeURIComponent('¡Hola Malabar Eventos! Me gustaría coordinar una visita para conocer las comodidades e instalaciones del salón en Tandil.')}`;

const amenities = [
	{
		title: 'Vista Panorámica a las Sierras',
		detail: 'Ventanales vidriados continuos de piso a techo con vista directa al cordón serrano de Tandil y sus atardeceres.',
		badge: 'PAISAJE ÚNICO',
		icon: 'mountain'
	},
	{
		title: 'Fogonero Criollo & Sector de Fuegos',
		detail: 'Asador a las brasas a la vista con nuestro icónico cartel "FOOD" para costillares, vacíos y vegetales ahumados.',
		badge: 'FUEGOS EN VIVO',
		icon: 'fire'
	},
	{
		title: 'Cava de Vinos Exclusiva',
		detail: 'Sector enológico privado con etiquetas seleccionadas de bodegas boutique para degustaciones, maridajes y recepciones.',
		badge: 'ENOLOGÍA',
		icon: 'wine'
	},
	{
		title: 'Cabina de DJ & Sonido Envolvente',
		detail: 'Equipamiento acústico lineal de alta fidelidad, consolas de mezcla profesional y DJ en vivo para la pista de baile.',
		badge: 'SONIDO PREMIUM',
		icon: 'dj'
	},
	{
		title: 'Pantalla LED Gigante de Alta Resolución',
		detail: 'Pantalla de gran formato para homenajes, videos emotivos, visuales sincronizadas con la música y shows en vivo.',
		badge: 'PANTALLA LED',
		icon: 'screen'
	},
	{
		title: 'Iluminación Robótica & Ambiental DMX',
		detail: 'Cabezales móviles computarizados, reflectores escénicos, luces perimetrales, guirnaldas y faroles de vela.',
		badge: 'SHOW DE LUCES',
		icon: 'light'
	},
	{
		title: 'Barra de Coctelería Interior & Exterior',
		detail: 'Barras de diseño atendidas por bartenders profesionales con tragos de autor, clásicos y mocktails frutales.',
		badge: 'COCTELERÍA',
		icon: 'cocktail'
	},
	{
		title: 'Parque & Escalinatas Iluminadas',
		detail: 'Espacio al aire libre con escalinatas de ingreso (ideales para letras XV luminosas), faroles y livings en el parque.',
		badge: 'PARQUE SERRANO',
		icon: 'park'
	},
	{
		title: 'Livings Contemporáneos & Mobiliario',
		detail: 'Sillones contemporáneos, mesas altas, banquetas de diseño, barras y livings para máximo confort de los invitados.',
		badge: 'AMBIENTACIÓN',
		icon: 'sofa'
	},
	{
		title: 'Climatización Central Frío / Calor',
		detail: 'Sistema de aire acondicionado central que garantiza una temperatura agradable y confortable durante todo el año.',
		badge: 'CLIMATIZACIÓN',
		icon: 'thermometer'
	},
	{
		title: 'Grupo Electrógeno Propio de Gran Potencia',
		detail: 'Respaldo eléctrico total de emergencia para que la música, pantallas, luces y cocina nunca se interrumpan.',
		badge: 'ENERGÍA SEGURA',
		icon: 'bolt'
	},
	{
		title: 'Estacionamiento Privado Seguro',
		detail: 'Playa de estacionamiento vigilada dentro del predio privado de Malabar sobre Av. Don Bosco 405.',
		badge: 'SEGURIDAD & ACCESO',
		icon: 'parking'
	},
	{
		title: 'Suite / Camarín Privado para Agasajados',
		detail: 'Espacio íntimo, cómodo y reservado exclusivamente para los novios, la quinceañera o anfitriones del evento.',
		badge: 'SUITE PRIVADA',
		icon: 'star'
	},
	{
		title: 'Seguridad, Guardarropa & Coordinación',
		detail: 'Personal de recepción, guardarropa, seguridad privada, camareros de sala y coordinador integral durante toda la velada.',
		badge: 'STAFF PROFESIONAL',
		icon: 'users'
	},
	{
		title: 'Vajilla Completa & Cristalería Fina',
		detail: 'Copas de cristal para brindis y cócteles, vajilla de porcelana, mantelería elegante y cubertería de categoría.',
		badge: 'VAJILLA & COPAS',
		icon: 'utensils'
	},
	{
		title: 'Sanitarios de Categoría & Accesibilidad',
		detail: 'Baños amplios, modernos y equipados con insumos de cortesía y accesibilidad universal para personas con movilidad reducida.',
		badge: 'CONFORT TOTAL',
		icon: 'check'
	}
];
---

<section id="comodidades" class="w-11/12 lg:w-4/5 max-w-7xl mx-auto py-16 lg:py-24 text-black">
	<!-- Encabezado editorial -->
	<div class="text-left max-w-3xl mb-14">
		<span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[#261B14] block mb-2">
			Infraestructura & Servicios Incluidos
		</span>
		<h2 class="font-cinzel text-3xl sm:text-4xl lg:text-5xl font-light text-black uppercase leading-tight tracking-tight">
			Comodidades del Salón
		</h2>
		<div class="w-14 h-px bg-black/25 my-5"></div>
		<p class="text-neutral-600 text-xs sm:text-sm tracking-wide font-light max-w-2xl leading-relaxed">
			Todo lo que necesitás para que tu fiesta o evento en Tandil sea inolvidable. Instalaciones de vanguardia, tecnología audiovisual y gastronomía al pie de las sierras.
		</p>
	</div>

	<!-- Grilla geométrica sin bordes redondeados -->
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-neutral-200 border border-black/15 shadow-sm">
		{amenities.map((item, index) => (
			<div class="group p-7 sm:p-8 bg-white hover:bg-neutral-50 transition-colors duration-300 flex flex-col justify-between">
				<div>
					<div class="flex items-center justify-between gap-3 mb-6">
						<span class="text-[10px] font-semibold text-neutral-400 group-hover:text-black font-cinzel transition-colors">
							{String(index + 1).padStart(2, '0')}
						</span>

						<span class="text-[9px] font-medium uppercase tracking-[0.2em] px-2 py-0.5 border border-[#261B14]/30 text-[#261B14] bg-neutral-50">
							{item.badge}
						</span>
					</div>

					<h3 class="font-cinzel text-lg text-black uppercase tracking-wide leading-snug mb-3 group-hover:text-neutral-800 transition-colors">
						{item.title}
					</h3>

					<p class="text-xs text-neutral-600 font-light leading-relaxed">
						{item.detail}
					</p>
				</div>

				<div class="mt-8 pt-4 border-t border-black/10 flex items-center justify-between">
					<span class="text-[10px] uppercase tracking-widest text-neutral-400 font-light">
						Malabar Tandil
					</span>
					<span class="text-black text-xs group-hover:translate-x-1 transition-transform">
						→
					</span>
				</div>
			</div>
		))}
	</div>

	<!-- Banner inferior con llamado a coordinar visita guiada -->
	<div class="mt-12 p-8 border border-black/15 bg-neutral-50 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
		<div>
			<span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#261B14] block mb-1">
				Visitas Guiadas al Salón
			</span>
			<h3 class="font-cinzel text-xl sm:text-2xl text-black uppercase font-light">
				¿Querés conocer las instalaciones en persona?
			</h3>
			<p class="text-xs sm:text-sm text-neutral-600 font-light mt-1">
				Vení a conocer nuestras escalinatas, el parque, la vista a las sierras y el sector de fuegos en Av. Don Bosco 405.
			</p>
		</div>

		<a
			href={defaultWhatsapp}
			target="_blank"
			rel="noopener noreferrer"
			class="shrink-0 inline-flex items-center gap-2 border border-black bg-black hover:bg-white text-white hover:text-black font-semibold text-xs uppercase tracking-[0.2em] py-3.5 px-8 transition-all duration-300"
		>
			<span>Coordinar Visita</span>
			<span>→</span>
		</a>
	</div>
</section>
