---
import siteData from '../data/data.json';
import Title from './Title.astro';
import WhatsappButton from './WhatsAppButton.astro';

interface Props {
	headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
const { website } = siteData;

const whatsappHref = `https://api.whatsapp.com/send?phone=${encodeURIComponent(website.telephone)}&text=${encodeURIComponent('¡Hola Malabar Eventos! Me comunico desde la web para consultar información y disponibilidad para un evento.')}`;
---
<Title title="Contactanos" description="Estamos a tu entera disposición para planificar tu fiesta o evento en Tandil" level={headingLevel}/>

<section class="animate-fade-in-up w-11/12 lg:w-4/5 max-w-5xl mx-auto py-8 text-black">
	<div class="border border-black/15 bg-white p-8 sm:p-12 lg:p-14 text-center shadow-sm">
		<span class="text-[10px] font-semibold uppercase tracking-[0.3em] text-[#261B14] block mb-2">
			Canales de Comunicación Directa
		</span>
		<h2 class="text-2xl sm:text-4xl font-cinzel font-light text-black uppercase tracking-tight">¿Querés visitarnos o celebrar con nosotros?</h2>
		<div class="w-12 h-px bg-black/25 mx-auto my-4"></div>
		<p class="mt-2 max-w-xl mx-auto text-xs sm:text-sm text-neutral-600 leading-relaxed font-light">
			Escribinos por WhatsApp al <strong class="text-black font-medium">{website.phoneDisplay || '+54 9 249 464-2400'}</strong> para coordinar una visita a nuestras instalaciones en Av. Don Bosco (Tandil) o contactanos por nuestras redes oficiales.
		</p>
		
		<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
			<a
				href={whatsappHref}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center justify-center gap-2 border border-black bg-black hover:bg-white text-white hover:text-black font-semibold text-xs uppercase tracking-[0.2em] py-3.5 px-6 transition-all duration-300"
			>
				<span>Escribir por WhatsApp</span>
				<span>→</span>
			</a>

			{website.instagram && (
				<a
					href={website.instagram}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2.5 border border-black/20 hover:border-black px-5 py-3 text-xs uppercase tracking-[0.2em] font-medium text-black hover:bg-neutral-50 transition-all duration-300"
				>
					<svg class="w-4 h-4 text-black" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.449-1.44z"/>
					</svg>
					<span>Instagram @malabareventos_</span>
				</a>
			)}

			{website.facebook && (
				<a
					href={website.facebook}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2.5 border border-black/20 hover:border-black px-5 py-3 text-xs uppercase tracking-[0.2em] font-medium text-black hover:bg-neutral-50 transition-all duration-300"
				>
					<svg class="w-4 h-4 text-black" fill="currentColor" viewBox="0 0 24 24">
						<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
					</svg>
					<span>Facebook Malabar Tandil</span>
				</a>
			)}
		</div>
	</div>
</section>
