---
import siteData from '../data/data.json';

interface Props {
	headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
const { website } = siteData;
const Tag = headingLevel === 1 ? 'h1' : 'h2';
---

<section id="reservas" class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-8">
	<div data-grow class="relative overflow-hidden rounded-[2rem] bg-secondary px-6 py-20 text-main sm:px-14 sm:py-28">
		<div class="relative z-10 mx-auto max-w-3xl text-center">
			<p data-anim="up" class="text-xs font-medium uppercase tracking-[0.25em] text-main/60">Reservas</p>
			<Tag data-anim="up" class="mt-5 font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
				¿Tenés una fecha en mente?
			</Tag>
			<p data-anim="up" class="mx-auto mt-6 max-w-xl text-main/75 sm:text-lg">
				Completá un cuestionario de un minuto y te respondemos con disponibilidad y propuestas para tu evento.
			</p>
			<div data-anim="up" class="mt-10 flex flex-wrap items-center justify-center gap-3">
				<a
					href="/reservar"
					data-magnetic
					class="group inline-flex items-center gap-3 rounded-full bg-main py-2 pl-7 pr-2 text-sm font-semibold text-secondary"
				>
					Armar mi reserva
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-secondary text-main transition-transform duration-500 group-hover:-rotate-45">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
					</span>
				</a>
				<a
					href={website.instagramDM}
					target="_blank"
					rel="noopener noreferrer"
					data-magnetic
					class="inline-flex items-center gap-2.5 rounded-full border border-main/30 px-7 py-[1.1rem] text-sm font-medium text-main transition-colors hover:border-main"
				>
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
					Escribir por MD
				</a>
			</div>
		</div>
		<img data-spin="40" src="/images/lodecarlin/logo.png" alt="" aria-hidden="true" class="pointer-events-none absolute -bottom-20 -right-20 hidden h-80 w-80 rounded-full opacity-[0.08] sm:block" />
		<img data-spin="55" src="/images/lodecarlin/logo.png" alt="" aria-hidden="true" class="pointer-events-none absolute -left-16 -top-16 hidden h-56 w-56 rounded-full opacity-[0.05] sm:block" />
	</div>
</section>
