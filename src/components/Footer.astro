---
import siteData from '../data/data.json';
import Logo from './Logo.astro';
import GammaStudioLogo from './GammaStudioLogo.astro';
import productsData from '../data/products.json';

const { website } = siteData;
const { products } = productsData;
---

<footer class="mt-12 border-t border-secondary/10">
	<div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-8 md:grid-cols-12">
		<div class="md:col-span-5">
			<Logo footer />
			<p class="mt-6 max-w-sm text-sm leading-relaxed text-secondary/65">
				Salón de eventos en {website.city}, {website.province}. Reservas por mensaje directo.
			</p>
		</div>

		<div class="md:col-span-3">
			<p class="text-xs font-medium uppercase tracking-[0.25em] text-secondary/50">Eventos</p>
			<ul class="mt-4 space-y-2 text-sm">
				{products.map((p) => (
					<li><a href={`/productView/${p.id}`} class="text-secondary/75 transition-colors hover:text-secondary">{p.name}</a></li>
				))}
			</ul>
		</div>

		<div class="md:col-span-4">
			<p class="text-xs font-medium uppercase tracking-[0.25em] text-secondary/50">Contacto</p>
			<ul class="mt-4 space-y-2 text-sm">
				<li><a href="/reservar" class="text-secondary/75 transition-colors hover:text-secondary">Cuestionario de reserva</a></li>
				<li><a href="/contacto" class="text-secondary/75 transition-colors hover:text-secondary">Contacto</a></li>
				<li><a href={website.instagram} target="_blank" rel="noopener noreferrer" class="text-secondary/75 transition-colors hover:text-secondary">Instagram {website.instagramHandle}</a></li>
				<li><a href={website.instagramDM} target="_blank" rel="noopener noreferrer" class="text-secondary/75 transition-colors hover:text-secondary">Enviar mensaje directo</a></li>
				<li><a href={website.ubication} target="_blank" rel="noopener noreferrer" class="text-secondary/75 transition-colors hover:text-secondary">Cómo llegar</a></li>
			</ul>
		</div>
	</div>

	<div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 border-t border-secondary/10 px-4 py-6 text-xs text-secondary/50 sm:flex-row sm:px-8">
		<span>&copy; {new Date().getFullYear()} {website.name}. Todos los derechos reservados.</span>
		<span class="flex items-center gap-2">
			Desarrollado por
			<a href="https://landing-gamma-studio.gammastudiosa.workers.dev/" target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-70">
				<GammaStudioLogo />
			</a>
		</span>
	</div>
</footer>
