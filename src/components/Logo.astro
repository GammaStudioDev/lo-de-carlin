---
import siteData from '../data/data.json';

interface Props {
	footer?: boolean;
}

const { website } = siteData;
const { footer = false } = Astro.props;
---

<span class="flex items-center gap-3 select-none">
	<img
		src="/images/lodecarlin/logo.png"
		alt={website.name}
		width="240"
		height="240"
		loading="eager"
		class:list={['object-cover', footer ? 'h-16 w-16' : 'h-10 w-10 sm:h-11 sm:w-11']}
	/>
	<span class="flex flex-col leading-none">
		<span class:list={['font-display font-extrabold tracking-tight text-secondary', footer ? 'text-2xl' : 'text-lg']}>
			{website.name}
		</span>
		<span class="mt-1 text-[10px] font-medium uppercase tracking-[0.25em] text-secondary/60">
			Salón de eventos
		</span>
	</span>
</span>
