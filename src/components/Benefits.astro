---
interface BenefitItem {
	title: string;
	description: string;
	icon: 'shield' | 'card' | 'bolt' | 'percent' | 'document' | 'clock';
}

interface Props {
	items: BenefitItem[];
}

const { items } = Astro.props;
---

<div class:list={["grid gap-px bg-neutral-200 border border-black/15", items.length >= 4 ? "sm:grid-cols-2 lg:grid-cols-4" : "sm:grid-cols-3"]}>
		{items.map(({ title, description, icon }, index) => (
			<div class="animate-fade-in-up animate-duration-500 flex flex-col items-center text-center gap-3 bg-white hover:bg-neutral-50 px-6 py-8 transition-colors duration-300" style={`animation-delay: ${index * 100}ms`}>
				<span class="flex items-center justify-center w-12 h-12 border border-black/20 text-black">
					<svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" class="w-6 h-6 stroke-black" aria-hidden="true">
						{icon === 'shield' && (
							<path stroke-linecap="square" stroke-linejoin="miter" d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z" />
						)}
						{icon === 'shield' && (
							<path stroke-linecap="square" stroke-linejoin="miter" d="M9 12l2 2 4-4" />
						)}
						{icon === 'card' && (
							<rect x="3" y="6" width="18" height="12" stroke-linecap="square" stroke-linejoin="miter" />
						)}
						{icon === 'card' && (
							<circle cx="12" cy="12" r="2" stroke-linecap="square" stroke-linejoin="miter" />
						)}
						{icon === 'bolt' && (
							<path stroke-linecap="square" stroke-linejoin="miter" d="M13 3L5 14h5l-1 7 8-11h-5z" />
						)}
						{icon === 'percent' && (
							<circle cx="7.5" cy="7.5" r="2.5" stroke-linecap="square" stroke-linejoin="miter" />
						)}
						{icon === 'percent' && (
							<circle cx="16.5" cy="16.5" r="2.5" stroke-linecap="square" stroke-linejoin="miter" />
						)}
						{icon === 'percent' && (
							<path stroke-linecap="square" stroke-linejoin="miter" d="M6 18L18 6" />
						)}
						{icon === 'document' && (
							<path stroke-linecap="square" stroke-linejoin="miter" d="M8 3h6l4 4v13a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" />
						)}
						{icon === 'document' && (
							<path stroke-linecap="square" stroke-linejoin="miter" d="M14 3v4h4" />
						)}
						{icon === 'document' && (
							<path stroke-linecap="square" stroke-linejoin="miter" d="M9.5 14.5l2 2 3.5-3.5" />
						)}
						{icon === 'clock' && (
							<circle cx="12" cy="12" r="8.5" stroke-linecap="square" stroke-linejoin="miter" />
						)}
						{icon === 'clock' && (
							<path stroke-linecap="square" stroke-linejoin="miter" d="M12 7.5V12l3 2" />
						)}
					</svg>
				</span>
				<h3 class="font-cinzel uppercase text-sm tracking-wider text-black font-normal">{title}</h3>
				<p class="text-xs text-neutral-600 font-light leading-relaxed">{description}</p>
			</div>
		))}
	</div>
