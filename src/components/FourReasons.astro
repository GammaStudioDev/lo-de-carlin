---
import siteData from '../data/data.json';

const { website } = siteData;
const defaultWhatsapp = `https://api.whatsapp.com/send?phone=${encodeURIComponent(website.telephone)}&text=${encodeURIComponent('¡Hola Malabar Eventos! Me comunico para consultar disponibilidad y presupuesto para un evento.')}`;

const reasons = [
	{
		number: '01',
		title: 'Con vista espectacular a nuestras sierras',
		badge: 'SPOT EN LAS SIERRAS',
		description: 'Un entorno natural único en Tandil. Atardeceres dorados y ventanales panorámicos que enmarcan cada momento.',
		accent: 'border-white/20'
	},
	{
		number: '02',
		title: 'Fogonero en vivo & Cava de vinos exclusiva',
		badge: 'FUEGOS & CAVA',
		description: 'Asado criollo a las brasas a la vista con nuestro cartel "FOOD" y sector de cava para maridajes distinguidos.',
		accent: 'border-white/20'
	},
	{
		number: '03',
		title: 'Cabina de DJ, iluminación & Pantalla LED',
		badge: 'SHOW & PISTA',
		description: 'Setup audiovisual de máxima gama para que la fiesta vibre con sonido envolvente y visuales de impacto.',
		accent: 'border-white/20'
	},
	{
		number: '04',
		title: 'Malabar Itinerante: Llevamos la experiencia adonde vos elijas',
		badge: 'MALABAR ITINERANTE',
		description: 'Salimos de nuestra locación para trasladar el servicio de DJ, sonido, pantallas, barra y catering a tu quinta o campo.',
		accent: 'border-white/20'
	}
];
---

<section id="motivos" class="w-11/12 lg:w-4/5 max-w-7xl mx-auto py-16 lg:py-24 text-black">
	<!-- Encabezado de la sección estilo Mas Momentos Únicos -->
	<div class="text-left max-w-2xl mb-14">
		<span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-neutral-500 block mb-2">
			Nuestra Propuesta
		</span>
		<h2 class="font-cinzel text-3xl sm:text-4xl lg:text-5xl font-light text-black uppercase leading-tight tracking-tight">
			4 Razones para Elegir Malabar
		</h2>
		<div class="w-12 h-px bg-black/25 my-5"></div>
		<p class="text-neutral-600 text-xs sm:text-sm tracking-wide">
			En Malabar no solo hacemos eventos: creamos experiencias que dejan huella.
		</p>
	</div>

	<!-- Grilla geométrica sin bordes redondeados -->
	<div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-neutral-200 border border-black/15">
		{reasons.map((item) => (
			<div class="group relative p-8 sm:p-10 bg-white hover:bg-neutral-50 transition-colors duration-300 flex flex-col justify-between">
				<div>
					<div class="flex items-center justify-between gap-4 mb-6">
						<span class="px-3 py-1 text-[10px] font-medium uppercase tracking-[0.25em] border border-[#261B14]/25 text-[#261B14] bg-neutral-50">
							{item.badge}
						</span>

						<span class="font-cinzel text-2xl text-neutral-300 group-hover:text-black transition-colors duration-300">
							{item.number}
						</span>
					</div>

					<h3 class="font-cinzel text-xl sm:text-2xl text-black uppercase leading-snug font-normal tracking-wide group-hover:text-neutral-800 transition-colors">
						{item.title}
					</h3>

					<p class="text-xs sm:text-sm text-neutral-600 mt-4 leading-relaxed font-light">
						{item.description}
					</p>
				</div>

				<div class="mt-8 pt-4 border-t border-black/10 flex items-center justify-between text-xs tracking-widest uppercase">
					<span class="text-neutral-400 text-[10px]">
						Exclusivo Malabar Tandil
					</span>

					<a
						href={defaultWhatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="text-black hover:text-neutral-600 inline-flex items-center gap-2 group/link font-medium"
					>
						<span>Consultar</span>
						<span class="transition-transform group-hover/link:translate-x-1">→</span>
					</a>
				</div>
			</div>
		))}
	</div>
</section>
