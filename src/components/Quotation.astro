---
import siteData from '../data/data.json';
import Title from './Title.astro';

interface Props {
	headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
const { website } = siteData;
---

<Title title="Consultá y Cotizá tu Evento" description="Coordiná tu fecha y recibí presupuesto al instante por WhatsApp" level={headingLevel}/>

<section id="reservas" class="animate-fade-in-up w-11/12 lg:w-4/5 max-w-7xl mx-auto py-8 text-black">
	<div class="border border-black/15 bg-white p-8 sm:p-12 lg:p-16 shadow-sm">
		<div class="max-w-2xl mx-auto text-center mb-10">
			<span class="text-[10px] font-semibold uppercase tracking-[0.3em] text-[#261B14] block mb-2">
				Atención Inmediata
			</span>
			<h3 class="font-cinzel text-2xl sm:text-4xl font-light text-black uppercase tracking-tight">
				Planificá tu Celebración en Malabar
			</h3>
			<div class="w-12 h-px bg-black/25 mx-auto my-4"></div>
			<p class="text-neutral-600 text-xs sm:text-sm font-light">
				Completá los datos y te preparamos la mejor propuesta personalizada directo por WhatsApp.
			</p>
		</div>

		<div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
			<!-- Tipo de Evento -->
			<div class="flex flex-col gap-2">
				<label for="booking-type" class="text-[11px] font-medium uppercase tracking-[0.2em] text-neutral-700">Tipo de Evento</label>
				<select
					id="booking-type"
					class="border border-black/20 bg-white text-black px-4 py-3.5 outline-none focus:border-black transition-colors text-sm"
				>
					<option value="Casamiento en las Sierras">💍 Casamiento en las Sierras</option>
					<option value="Fiesta de 15 Años (DJ, Pista & Pantalla LED)">👑 Fiesta de 15 Años (DJ, Pista & Pantalla LED)</option>
					<option value="Cumpleaños & Aniversario">🎂 Cumpleaños & Aniversario</option>
					<option value="Evento Empresarial / Corporativo">💼 Evento Empresarial / Corporativo</option>
					<option value="Sunset Serrano con Cava & Fuegos">⛰️ Sunset Serrano con Cava & Fuegos</option>
					<option value="Malabar Itinerante (Servicio a domicilio/quinta)">🚀 Malabar Itinerante (DJ, Sonido, Luces & Barra a domicilio)</option>
					<option value="Otra Celebración">✨ Otra Celebración</option>
				</select>
			</div>

			<!-- Nombre y Apellido -->
			<div class="flex flex-col gap-2">
				<label for="booking-name" class="text-[11px] font-medium uppercase tracking-[0.2em] text-neutral-700">Tu Nombre</label>
				<input
					id="booking-name"
					type="text"
					required
					placeholder="Ej: Carolina Rossi"
					class="border border-black/20 bg-white text-black placeholder:text-neutral-400 px-4 py-3.5 outline-none focus:border-black transition-colors text-sm"
				/>
			</div>

			<!-- Fecha estimada -->
			<div class="flex flex-col gap-2">
				<label for="booking-date" class="text-[11px] font-medium uppercase tracking-[0.2em] text-neutral-700">Fecha Estimada</label>
				<input
					id="booking-date"
					type="date"
					class="border border-black/20 bg-white text-black px-4 py-3.5 outline-none focus:border-black transition-colors text-sm"
				/>
			</div>

			<!-- Cantidad de comensales -->
			<div class="flex flex-col gap-2">
				<label for="booking-guests" class="text-[11px] font-medium uppercase tracking-[0.2em] text-neutral-700">Cantidad Estimada de Invitados</label>
				<input
					id="booking-guests"
					type="number"
					inputmode="numeric"
					min="1"
					max="500"
					placeholder="Ej: 130 personas"
					class="border border-black/20 bg-white text-black placeholder:text-neutral-400 px-4 py-3.5 outline-none focus:border-black transition-colors text-sm"
				/>
			</div>

			<!-- Horario / Turno -->
			<div class="flex flex-col gap-2 sm:col-span-2">
				<label for="booking-time" class="text-[11px] font-medium uppercase tracking-[0.2em] text-neutral-700">Horario o Modalidad Deseada</label>
				<select
					id="booking-time"
					class="border border-black/20 bg-white text-black px-4 py-3.5 outline-none focus:border-black transition-colors text-sm"
				>
					<option value="Turno Noche (Pista de baile, DJ & Pantalla LED)">Turno Noche — Pista encendida con DJ & Pantalla LED</option>
					<option value="Sunset / Atardecer Serrano (Fuegos & Cava)">Sunset / Atardecer Serrano — Recepción en parque & fuegos</option>
					<option value="Mediodía (Almuerzo Criollo & Tarde)">Mediodía — Almuerzo criollo y tarde al aire libre</option>
					<option value="A Coordinar">A Coordinar</option>
				</select>
			</div>
		</div>

		<div class="mt-10 flex flex-col items-center gap-3">
			<a
				id="booking-whatsapp-link"
				href="#"
				class="inline-flex items-center justify-center gap-3 border border-black bg-black hover:bg-white text-white hover:text-black font-semibold text-xs uppercase tracking-[0.2em] py-4 px-10 transition-all duration-300 pointer-events-none opacity-50"
				aria-disabled="true"
			>
				<span>Enviar Consulta por WhatsApp</span>
				<span>→</span>
			</a>
			<p id="booking-hint" class="text-xs text-neutral-500 font-light">Completá tu nombre para habilitar el mensaje directo.</p>
		</div>
	</div>
</section>

<script define:vars={{ telephone: website.telephone }}>
	document.addEventListener('astro:page-load', () => {
		const type = document.getElementById('booking-type');
		const name = document.getElementById('booking-name');
		const date = document.getElementById('booking-date');
		const guests = document.getElementById('booking-guests');
		const time = document.getElementById('booking-time');
		const link = document.getElementById('booking-whatsapp-link');
		const hint = document.getElementById('booking-hint');

		if (
			!(type instanceof HTMLSelectElement) ||
			!(name instanceof HTMLInputElement) ||
			!(date instanceof HTMLInputElement) ||
			!(guests instanceof HTMLInputElement) ||
			!(time instanceof HTMLSelectElement) ||
			!(link instanceof HTMLAnchorElement) ||
			!hint
		) return;

		function updateLink() {
			const typeVal = type.value;
			const nameVal = name.value.trim();
			const dateVal = date.value;
			const guestsVal = guests.value.trim();
			const timeVal = time.value;
			const isReady = nameVal.length >= 2;

			if (!isReady) {
				link.setAttribute('href', '#');
				link.setAttribute('aria-disabled', 'true');
				link.classList.add('pointer-events-none', 'opacity-50');
				hint.textContent = 'Ingresá tu nombre para habilitar la consulta por WhatsApp.';
				return;
			}

			let message = `¡Hola Malabar Eventos! Mi nombre es *${nameVal}*.\nQuiero consultar presupuesto y disponibilidad para: *${typeVal}*`;
			if (dateVal) {
				message += `\n📅 Fecha estimada: ${dateVal}`;
			}
			if (guestsVal) {
				message += `\n👥 Cantidad estimada de invitados: ${guestsVal} personas`;
			}
			message += `\n⏰ Modalidad: ${timeVal}`;
			message += `\n\n¿Me podrían brindar información sobre propuestas y disponibilidad? ¡Muchas gracias!`;

			link.setAttribute('href', `https://api.whatsapp.com/send?phone=${encodeURIComponent(telephone)}&text=${encodeURIComponent(message)}`);
			link.removeAttribute('aria-disabled');
			link.classList.remove('pointer-events-none', 'opacity-50');
			hint.textContent = '✨ Te redirecciona directo a WhatsApp con tu consulta armada.';
		}

		[type, name, date, guests, time].forEach((input) => {
			input.addEventListener('input', updateLink);
			input.addEventListener('change', updateLink);
		});

		link.addEventListener('click', (event) => {
			if (link.getAttribute('aria-disabled') === 'true') {
				event.preventDefault();
			}
		});

		updateLink();
	});
</script>
