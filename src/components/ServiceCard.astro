---
interface Product {
	id: number;
	name: string;
	description: string;
	category: string[];
	features?: string[];
	images: string[];
}

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<a
	href={`/productView/${product.id}`}
	class="group relative flex flex-col h-full border border-black/15 bg-white hover:border-black transition-all duration-300 isolate cursor-pointer"
>
	<!-- Imagen de cabecera con overlay -->
	<div class="relative h-60 sm:h-64 w-full overflow-hidden bg-neutral-100 border-b border-black/15">
		<img
			src={product.images[0]}
			alt={product.name}
			loading="lazy"
			transition:name={`product-image-${product.id}`}
			class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
		
		<!-- Badge de categoría con bordes nítidos -->
		<div class="absolute top-4 left-4">
			<span class="inline-flex items-center gap-2 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] bg-white/95 text-black border border-black/20">
				<span class="w-1.5 h-1.5 bg-[#261B14] animate-pulse"></span>
				{product.category[0] || 'Experiencia'}
			</span>
		</div>

		<!-- Título sobre imagen -->
		<div class="absolute bottom-4 left-4 right-4">
			<h3
				class="font-cinzel font-normal text-xl sm:text-2xl text-white tracking-wide leading-tight drop-shadow-md group-hover:text-neutral-200 transition-colors duration-300 uppercase"
				transition:name={`product-name-${product.id}`}
			>
				{product.name}
			</h3>
		</div>
	</div>

	<!-- Cuerpo de la tarjeta -->
	<div class="p-6 sm:p-8 flex-1 flex flex-col justify-between gap-6">
		<div class="flex flex-col gap-4">
			<p class="text-neutral-600 text-xs sm:text-sm leading-relaxed font-light">
				{product.description}
			</p>

			<!-- Lista de características incluidas -->
			{product.features && product.features.length > 0 && (
				<div class="pt-4 border-t border-black/10">
					<span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-neutral-500 mb-3 block">
						Destacados:
					</span>
					<ul class="grid grid-cols-1 gap-2">
						{product.features.slice(0, 3).map((feat) => (
							<li class="flex items-start gap-2.5 text-xs text-neutral-700 font-light">
								<span class="w-1.5 h-1.5 bg-[#261B14] shrink-0 mt-1.5"></span>
								<span>{feat}</span>
							</li>
						))}
					</ul>
				</div>
			)}
		</div>

		<!-- Botón interactivo sharp de ver detalle -->
		<div class="pt-4 mt-auto">
			<span
				class="w-full inline-flex items-center justify-center gap-2 border border-black text-black group-hover:bg-black group-hover:text-white font-semibold text-xs uppercase tracking-[0.2em] py-3.5 px-4 transition-all duration-300"
			>
				<span>Ver detalles y fotos</span>
				<span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
			</span>
		</div>
	</div>
</a>
