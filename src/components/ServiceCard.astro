---
interface Product {
	id: number;
	name: string;
	description: string;
	category: string[];
	features?: string[];
	images: string[];
}

interface Props {
	product: Product;
	index?: number;
	wide?: boolean;
}

const { product, index = 0, wide = false } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<a
	href={`/productView/${product.id}`}
	class="group relative flex h-full flex-col overflow-hidden rounded-[1.25rem] bg-main transition-shadow duration-500 hover:shadow-2xl hover:shadow-secondary/10"
>
	<div class="relative overflow-hidden">
		<img
			src={product.images[0]}
			alt={product.name}
			loading="lazy"
			transition:name={`product-image-${product.id}`}
			class:list={['w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-110', wide ? 'aspect-[16/9]' : 'aspect-[4/3]']}
		/>
		<span class="absolute left-4 top-4 rounded-full bg-main/90 px-3 py-1 font-display text-xs font-semibold text-secondary backdrop-blur">{number}</span>
		<span class="absolute bottom-4 right-4 flex h-11 w-11 translate-y-3 items-center justify-center rounded-full bg-secondary text-main opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
			<svg class="h-4 w-4 -rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
		</span>
	</div>
	<div class="flex flex-1 flex-col p-6 sm:p-7">
		<h3 class="font-display text-2xl font-bold tracking-tight text-secondary" transition:name={`product-name-${product.id}`}>
			{product.name}
		</h3>
		<p class="mt-3 flex-1 text-sm leading-relaxed text-secondary/70">{product.description}</p>
		<span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-secondary">
			<span class="relative">
				Ver propuesta
				<span class="absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 bg-secondary transition-transform duration-500 group-hover:scale-x-100"></span>
			</span>
		</span>
	</div>
</a>
