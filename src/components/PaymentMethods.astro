---
const methodsList = [
	{
		title: 'Efectivo Multidivisa',
		badge: 'ARS • USD • EUR',
		description: 'Aceptamos pagos en efectivo en Pesos argentinos, Dólares estadounidenses y Euros con cotización transparente.',
		icon: 'cash'
	},
	{
		title: 'Tarjetas de Crédito & Débito',
		badge: 'Bancarias & Digitales',
		description: 'Operamos con todas las tarjetas de crédito y débito de entidades bancarias nacionales e internacionales.',
		icon: 'card'
	},
	{
		title: 'Mercado Pago',
		badge: 'QR & Transferencias',
		description: 'Facilidad y rapidez a través de transferencias bancarias directas y cobro con código QR al instante.',
		icon: 'wallet'
	},
	{
		title: 'Criptomonedas',
		badge: 'BTC • ETH • USDT',
		description: 'Pioneros en Tandil: aboná tu evento de forma digital y segura con Bitcoin, Ethereum o USDT.',
		icon: 'crypto'
	}
];
---

<section id="medios-de-pago" class="w-11/12 lg:w-4/5 max-w-7xl mx-auto py-16 lg:py-24 text-black">
	<div class="text-left max-w-2xl mb-14">
		<span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-neutral-500 block mb-2">
			Flexibilidad & Comodidad
		</span>
		<h2 class="font-cinzel text-3xl sm:text-4xl lg:text-5xl font-light text-black uppercase leading-tight tracking-tight">
			Métodos de Pago
		</h2>
		<div class="w-12 h-px bg-black/25 my-5"></div>
		<p class="text-neutral-600 text-xs sm:text-sm tracking-wide">
			Opciones pensadas para que abones tu celebración con la alternativa más conveniente.
		</p>
	</div>

	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-neutral-200 border border-black/15">
		{methodsList.map((method) => (
			<div class="group flex flex-col justify-between p-8 bg-white hover:bg-neutral-50 transition-colors duration-300">
				<div>
					<div class="flex items-center justify-between gap-3 mb-6">
						<div class="w-11 h-11 flex items-center justify-center border border-black/20 text-black">
							{method.icon === 'cash' && (
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<rect x="2" y="6" width="20" height="12" stroke-width="1.5"/>
									<circle cx="12" cy="12" r="2" stroke-width="1.5"/>
									<path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M6 12h.01M18 12h.01" />
								</svg>
							)}
							{method.icon === 'card' && (
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<rect x="3" y="5" width="18" height="14" stroke-width="1.5"/>
									<path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M3 10h18M7 15h2m4 0h4" />
								</svg>
							)}
							{method.icon === 'wallet' && (
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a1 1 0 11-2 0 1 1 0 012 0z" />
								</svg>
							)}
							{method.icon === 'crypto' && (
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							)}
						</div>

						<span class="text-[9px] font-medium uppercase tracking-[0.2em] px-2 py-1 border border-[#261B14]/30 text-[#261B14] bg-neutral-50">
							{method.badge}
						</span>
					</div>

					<h3 class="font-cinzel text-lg text-black uppercase tracking-wide mb-2">
						{method.title}
					</h3>

					<p class="text-xs text-neutral-600 leading-relaxed font-light">
						{method.description}
					</p>
				</div>

				<div class="mt-8 pt-4 border-t border-black/10">
					<span class="text-[10px] font-medium text-neutral-400 uppercase tracking-widest flex items-center gap-1.5">
						<span>Aceptado en Malabar</span>
					</span>
				</div>
			</div>
		))}
	</div>
</section>
