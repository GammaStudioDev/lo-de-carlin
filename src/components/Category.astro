---
import ServiceCard from './ServiceCard.astro';
import productsData from '../data/products.json';
import Title from './Title.astro';

interface Props {
	showTitle?: boolean;
	cta?: boolean;
}

const { showTitle = true, cta = false } = Astro.props;
const { products } = productsData;
---

<section id="eventos" class="w-full bg-tertiary/50">
	<div class="mx-auto max-w-7xl px-4 py-24 sm:px-8 sm:py-32">
		{showTitle && (
			<div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
				<Title eyebrow="Eventos" title="Un lugar para cada celebración." />
				<p data-anim="up" class="max-w-sm text-secondary/70">
					Cumpleaños, casamientos, aniversarios, capacitaciones y más. Contanos qué querés festejar.
				</p>
			</div>
		)}

		<div data-anim-stagger class="grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
			{products.map((product, index) => (
				<div data-anim="up" class:list={['lg:col-span-2', index >= 3 && 'lg:col-span-3']}>
					<ServiceCard product={product} index={index} wide={index >= 3} />
				</div>
			))}
		</div>

		{cta && (
			<div data-anim="up" class="mt-14 flex justify-center">
				<a href="/eventos" data-magnetic class="inline-flex items-center gap-2 rounded-full bg-secondary px-7 py-4 text-sm font-semibold text-main transition-opacity hover:opacity-90">
					Ver todos los eventos
				</a>
			</div>
		)}
	</div>
</section>
