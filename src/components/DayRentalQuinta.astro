---
import siteData from '../data/data.json';

const { website } = siteData;
const wineWhatsapp = `https://api.whatsapp.com/send?phone=${encodeURIComponent(website.telephone)}&text=${encodeURIComponent('¡Hola Malabar Eventos! Me comunico para consultar disponibilidad y propuestas para un evento en el salón con cava de vinos y vista a las sierras.')}`;

const amenities = [
	{ name: 'Cava de vinos exclusiva para degustación' },
	{ name: 'Fogonero criollo central a la vista' },
	{ name: 'Ventanales panorámicos a las sierras' },
	{ name: 'Livings contemporáneos & faroles de vela' },
	{ name: 'Barra de coctelería interior y exterior' },
	{ name: 'Estacionamiento privado seguro en el predio' }
];

const inclusions = [
	'Mobiliario y ambientación de autor',
	'Cristalería fina y vajilla completa',
	'Climatización central frío/calor',
	'Grupo electrógeno propio',
	'Coordinación integral del evento'
];
---

<section id="cava-fuegos" class="w-11/12 lg:w-4/5 max-w-7xl mx-auto py-16 lg:py-24 text-black">
	<div class="border border-black/15 bg-white p-8 sm:p-12 lg:p-16 shadow-sm">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
			<!-- Columna izquierda: Información central -->
			<div class="lg:col-span-7 flex flex-col items-start text-left">
				<div class="inline-flex items-center gap-2 px-3 py-1 border border-[#261B14]/30 bg-neutral-50 mb-6">
					<span class="w-1.5 h-1.5 bg-[#261B14] animate-pulse"></span>
					<span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#261B14]">
						Cava & Atardeceres Serranos • Tandil
					</span>
				</div>

				<h2 class="font-cinzel text-3xl sm:text-5xl font-light text-black uppercase leading-tight tracking-tight">
					Cava de Vinos & Experiencia de Fuegos
				</h2>

				<div class="w-14 h-px bg-black/25 my-6"></div>

				<p class="text-neutral-700 text-sm sm:text-base leading-relaxed max-w-xl font-light">
					Disfrutá una velada distinguida donde la mística de las sierras tandileras se funde con aromas de brasas encendidas, etiquetas boutique seleccionadas y la calidez de nuestra cava privada.
				</p>

				<!-- Pills de Vista y Ubicación con bordes nítidos -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full max-w-lg mt-8">
					<div class="p-4 border border-black/15 bg-neutral-50">
						<span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-500 block mb-1">Paisaje & Entorno</span>
						<strong class="text-sm sm:text-base text-black font-montserrat font-medium uppercase tracking-wider">Atardecer en las Sierras</strong>
					</div>

					<div class="p-4 border border-black/15 bg-neutral-50">
						<span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-500 block mb-1">Locación Exclusiva</span>
						<strong class="text-sm sm:text-base text-black font-montserrat font-medium uppercase tracking-wider">Av. Don Bosco, Tandil</strong>
					</div>
				</div>

				<!-- Aviso de adaptabilidad -->
				<div class="mt-6 text-xs text-neutral-700 border-l-2 border-[#261B14] pl-4 py-2 font-light">
					<span><strong>Versatilidad total:</strong> Malabar se adapta tanto a recepciones íntimas como a grandes eventos sociales y corporativos.</span>
				</div>

				<!-- Botón de consulta sharp -->
				<div class="mt-10">
					<a
						href={wineWhatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-3 border border-black bg-black hover:bg-white text-white hover:text-black font-semibold text-xs uppercase tracking-[0.2em] py-4 px-8 transition-all duration-300"
					>
						<span>Consultar Fecha en Malabar</span>
						<span>→</span>
					</a>
				</div>
			</div>

			<!-- Columna derecha: Foto del interior, cava y livings + Comodidades -->
			<div class="lg:col-span-5 flex flex-col gap-6">
				<div class="relative overflow-hidden aspect-16/11 border border-black/15 group bg-neutral-100">
					<img
						src="/images/malabar/interior-cava.png"
						alt="Interior del salón Malabar con cava de vinos, livings y ambientación cálida"
						class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
					<span class="absolute bottom-3 left-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-white">
						Cava de Vinos & Salón • Tandil
					</span>
				</div>

				<!-- Tarjeta: El espacio cuenta con e Inclusiones -->
				<div class="p-6 border border-black/15 bg-neutral-50">
					<h3 class="font-montserrat font-semibold text-xs uppercase tracking-[0.25em] text-black mb-4 pb-2 border-b border-black/15">
						Infraestructura & Servicios Incluidos:
					</h3>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-neutral-700 font-light">
						{amenities.concat(inclusions.map(name => ({ name }))).slice(0, 8).map((item) => (
							<div class="flex items-center gap-2.5">
								<span class="w-1.5 h-1.5 bg-[#261B14] shrink-0"></span>
								<span>{item.name}</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
