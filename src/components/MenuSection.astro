---
import Title from './Title.astro';
import siteData from '../data/data.json';

const { website } = siteData;

const menuCategories = [
	{
		id: 'fuegos',
		title: 'Fuegos & Asado Criollo en Vivo',
		subtitle: 'Fogonero a las brasas, cortes seleccionados y cartel luminoso "FOOD"',
		image: '/images/malabar/catering-fuegos.png',
		highlights: [
			'Fogonero encendido a las brasas a la vista con nuestro cartel "FOOD"',
			'Costillares al asador, vacíos tiernizados, bondiola y vegetales ahumados',
			'Recepción criolla con quesos de campo y chacinados típicos de Tandil',
			'Empanadas tradicionales horneadas a leña cortadas a cuchillo',
			'Propuestas y alternativas vegetarianas, celíacas y veganas'
		]
	},
	{
		id: 'cava',
		title: 'Cava de Vinos & Experiencia Enológica',
		subtitle: 'Etiquetas boutique, maridajes guiados y cristalería de diseño',
		image: '/images/malabar/interior-cava.png',
		highlights: [
			'Espacio exclusivo de cava dentro de nuestro salón en Tandil',
			'Selección de etiquetas premiadas de bodegas boutique y tradicionales',
			'Maridajes pensados para potenciar los sabores de los fuegos',
			'Servicio de copas finas de cristal y asesoramiento enológico',
			'Degustaciones especiales para recepciones, bodas y cenas de empresa'
		]
	},
	{
		id: 'barras',
		title: 'Coctelería de Autor & Barras Premium',
		subtitle: 'Tragos artesanales con flores, clásicos y mocktails frutales',
		image: '/images/malabar/cocteleria-tragos.png',
		highlights: [
			'Barras atendidas por bartenders profesionales de principio a fin',
			'Cocktails de autor con macerados, botánicos y flores comestibles',
			'Clásicos de primera línea: Gin Tonic, Aperol Spritz, Negroni, Fernet',
			'Mocktails refrescantes sin alcohol para fiestas de 15 y conductores',
			'Cerveza tirada helada y champagne para el momento del brindis'
		]
	}
];

const orderWhatsapp = `https://api.whatsapp.com/send?phone=${encodeURIComponent(website.telephone)}&text=${encodeURIComponent('¡Hola Malabar Eventos! Me comunico para consultar propuestas de catering, fuegos y barra de tragos para mi evento.')}`;
---

<section id="menu" class="w-11/12 lg:w-4/5 max-w-7xl mx-auto py-16 lg:py-24 text-black">
	<div class="text-left max-w-2xl mb-14">
		<span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-neutral-500 block mb-2">
			Gastronomía & Barra
		</span>
		<h2 class="font-cinzel text-3xl sm:text-4xl lg:text-5xl font-light text-black uppercase leading-tight tracking-tight">
			Fuegos, Cava & Coctelería
		</h2>
		<div class="w-12 h-px bg-black/25 my-5"></div>
		<p class="text-neutral-600 text-xs sm:text-sm tracking-wide">
			Sabores criollos a las brasas, vinos seleccionados y coctelería de autor.
		</p>
	</div>

	<!-- Barra informativa de catering y pedidos con bordes rectos -->
	<div class="max-w-7xl mx-auto mb-12 p-6 border border-black/15 bg-neutral-50 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
		<div>
			<p class="font-cinzel font-normal text-black text-base sm:text-lg uppercase tracking-wider">
				Experiencia Gastronómica Integral • Malabar Tandil
			</p>
			<p class="text-xs sm:text-sm text-neutral-600 mt-1 font-light tracking-wide">
				Av. Don Bosco 405, Tandil • Consultas al <strong class="text-black font-medium">{website.phoneDisplay || '+54 9 249 464-2400'}</strong>
			</p>
		</div>

		<a
			href={orderWhatsapp}
			target="_blank"
			rel="noopener noreferrer"
			class="shrink-0 inline-flex items-center gap-2 border border-black bg-black hover:bg-white text-white hover:text-black font-semibold text-xs uppercase tracking-[0.2em] py-3.5 px-6 transition-all duration-300"
		>
			<span>Consultar Menú</span>
			<span>→</span>
		</a>
	</div>

	<!-- Grilla interactiva de propuestas -->
	<div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
		{menuCategories.map((menu, index) => (
			<article class="group flex flex-col border border-black/15 bg-white hover:border-black transition-all duration-300">
				<!-- Cabecera de la tarjeta -->
				<div class="p-6 border-b border-black/15">
					<span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#261B14] block mb-1">
						Propuesta 0{index + 1}
					</span>
					<h3 class="font-cinzel font-normal text-xl text-black uppercase leading-snug tracking-wide">
						{menu.title}
					</h3>
					<p class="text-xs text-neutral-600 mt-2 font-light">
						{menu.subtitle}
					</p>
				</div>

				<!-- Imagen de la propuesta con botón de zoom -->
				<div class="relative w-full aspect-4/3 overflow-hidden bg-neutral-100 cursor-pointer menu-image-trigger border-b border-black/15" data-img={menu.image} data-title={menu.title}>
					<img
						src={menu.image}
						alt={`Malabar - ${menu.title}`}
						loading="lazy"
						class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
					/>
					<div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors flex items-center justify-center">
						<span class="opacity-0 group-hover:opacity-100 transition-opacity bg-black text-white text-[10px] font-semibold uppercase tracking-[0.2em] px-4 py-2 border border-white/40 flex items-center gap-2">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
							<span>Ampliar Imagen</span>
						</span>
					</div>
				</div>

				<!-- Destacados y pie -->
				<div class="p-6 flex-1 flex flex-col justify-between gap-6">
					<div>
						<span class="text-[10px] font-semibold uppercase tracking-[0.25em] text-neutral-500 block mb-3">
							Incluye en esta propuesta:
						</span>
						<ul class="text-xs text-neutral-700 space-y-2 font-light">
							{menu.highlights.map((item) => (
								<li class="flex items-start gap-2.5">
									<span class="w-1.5 h-1.5 bg-[#261B14] shrink-0 mt-1.5"></span>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</div>

					<div class="pt-4 border-t border-black/10 flex gap-3">
						<a
							href={menu.image}
							target="_blank"
							rel="noopener noreferrer"
							class="flex-1 text-center py-3 border border-black/20 hover:border-black text-black text-xs uppercase tracking-[0.2em] font-medium transition-colors"
						>
							Ver Foto
						</a>
						<a
							href={orderWhatsapp}
							target="_blank"
							rel="noopener noreferrer"
							class="flex-1 text-center py-3 border border-black bg-black hover:bg-white text-white hover:text-black text-xs uppercase tracking-[0.2em] font-semibold transition-colors"
						>
							Consultar
						</a>
					</div>
				</div>
			</article>
		))}
	</div>

	<!-- Modal Lightbox sin bordes redondeados -->
	<div id="menu-lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4">
		<div class="relative max-w-2xl w-full max-h-[92vh] flex flex-col items-center border border-white/30 bg-black p-4">
			<button
				type="button"
				id="menu-lightbox-close"
				class="absolute -top-10 right-0 w-8 h-8 border border-white/40 bg-black hover:bg-white text-white hover:text-black flex items-center justify-center transition-colors focus:outline-none"
				aria-label="Cerrar vista"
			>
				✕
			</button>
			<img
				id="menu-lightbox-image"
				src=""
				alt="Propuesta ampliada de Malabar Eventos"
				class="max-h-[75vh] w-auto object-contain bg-black border border-white/15"
			/>
			<div class="mt-4 flex items-center gap-3">
				<a
					id="menu-lightbox-direct"
					href="#"
					target="_blank"
					class="text-[10px] uppercase tracking-[0.2em] text-white hover:underline border border-white/30 px-4 py-2"
				>
					Ver en tamaño original
				</a>
				<a
					href={orderWhatsapp}
					target="_blank"
					class="text-[10px] uppercase tracking-[0.2em] font-bold text-black bg-white hover:bg-neutral-200 px-4 py-2 transition-colors"
				>
					Pedir por WhatsApp
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	document.addEventListener('astro:page-load', () => {
		const modal = document.getElementById('menu-lightbox-modal');
		const modalImg = document.getElementById('menu-lightbox-image');
		const modalLink = document.getElementById('menu-lightbox-direct');
		const closeBtn = document.getElementById('menu-lightbox-close');
		const triggers = document.querySelectorAll('.menu-image-trigger');

		if (!modal || !modalImg || !(modalImg instanceof HTMLImageElement)) return;

		triggers.forEach((trigger) => {
			trigger.addEventListener('click', () => {
				const src = trigger.getAttribute('data-img');
				if (src) {
					modalImg.src = src;
					if (modalLink instanceof HTMLAnchorElement) {
						modalLink.href = src;
					}
					modal.classList.remove('hidden');
					modal.classList.add('flex');
					document.body.style.overflow = 'hidden';
				}
			});
		});

		const closeModal = () => {
			modal.classList.remove('flex');
			modal.classList.add('hidden');
			document.body.style.overflow = '';
		};

		if (closeBtn) closeBtn.addEventListener('click', closeModal);
		modal.addEventListener('click', (e) => {
			if (e.target === modal) closeModal();
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
				closeModal();
			}
		});
	});
</script>
