---
const highlightCards = [
	{
		title: 'Casamientos en las Sierras',
		tag: 'Bodas & Atardeceres',
		description: 'Ceremonias al atardecer frente a los cerros de Tandil, recepciones al aire libre en el parque iluminado y fiesta inolvidable.',
		image: '/images/malabar/casamiento-sierras.png',
		link: '/productView/1',
		linkText: 'Ver propuesta de casamientos'
	},
	{
		title: 'Fiestas de 15 Años',
		tag: 'Quinces & Pista LED',
		description: 'Entrada soñada por las escalinatas iluminadas con letras corpóreas "XV", pantalla LED gigante, cabina de DJ y mocktails de autor.',
		image: '/images/malabar/cumple-15-noche.png',
		link: '/productView/2',
		linkText: 'Ver fiesta de 15'
	},
	{
		title: 'Fuegos Criollos & Fogonero',
		tag: 'Gastronomía a las Brasas',
		description: 'Asado criollo al pie de las brasas con nuestro icónico cartel "FOOD", cortes al asador, cava y livings contemporáneos.',
		image: '/images/malabar/catering-fuegos.png',
		link: '/productView/3',
		linkText: 'Ver fuegos & eventos'
	}
];
---

<section class="w-11/12 lg:w-4/5 max-w-7xl mx-auto py-16 lg:py-24 text-black">
	<div class="text-left max-w-2xl mb-14">
		<span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-neutral-500 block mb-2">
			Portfolio & Espacios
		</span>
		<h2 class="font-cinzel text-3xl sm:text-4xl lg:text-5xl font-light text-black uppercase leading-tight tracking-tight">
			Espacios Diseñados para Celebrar
		</h2>
		<div class="w-12 h-px bg-black/25 my-5"></div>
		<p class="text-neutral-600 text-xs sm:text-sm tracking-wide">
			Un marco natural imponente en Tandil combinado con gastronomía a las brasas, cava enológica y tecnología audiovisual.
		</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
		{highlightCards.map((card) => (
			<div class="group flex flex-col justify-between border border-black/15 bg-white hover:border-black transition-all duration-300">
				<div>
					<!-- Imagen rectangular sin bordes redondeados -->
					<div class="relative aspect-16/10 w-full overflow-hidden bg-neutral-100 border-b border-black/15">
						<img
							src={card.image}
							alt={card.title}
							class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
							loading="lazy"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
						<span class="absolute top-3 left-3 text-[10px] uppercase tracking-[0.2em] px-2.5 py-1 bg-white/95 text-black border border-black/20 font-medium">
							{card.tag}
						</span>
					</div>

					<!-- Contenido -->
					<div class="p-6 sm:p-8">
						<h3 class="font-cinzel font-normal text-xl text-black uppercase tracking-wide mb-3 group-hover:text-neutral-700 transition-colors">
							{card.title}
						</h3>
						<p class="text-xs text-neutral-600 leading-relaxed font-light">
							{card.description}
						</p>
					</div>
				</div>

				<div class="px-6 pb-6 sm:px-8 sm:pb-8 pt-2">
					<a href={card.link} class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-black hover:text-neutral-600 font-medium transition-colors">
						<span>{card.linkText}</span>
						<span class="text-base transition-transform group-hover:translate-x-1">→</span>
					</a>
				</div>
			</div>
		))}
	</div>
</section>
