---
interface Props {
	title: string;
	eyebrow?: string;
	description?: string;
	level?: 1 | 2;
	align?: 'left' | 'center';
}

const { title, eyebrow, description, level = 2, align = 'left' } = Astro.props;
const Tag = level === 1 ? 'h1' : 'h2';
---

<div data-anim="up" class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
	{eyebrow && (
		<p class="mb-4 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.25em] text-secondary/60">
			<span class="h-px w-8 bg-secondary/40"></span>
			{eyebrow}
		</p>
	)}
	<Tag class="font-display text-4xl font-bold leading-tight tracking-tight text-secondary sm:text-5xl">
		{title}
	</Tag>
	{description && <p class="mt-4 text-base leading-relaxed text-secondary/70">{description}</p>}
</div>
