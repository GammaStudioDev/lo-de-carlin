---
import siteData from '../data/data.json';
import IconLight from '../assets/icon-w.webp';
import IconDark from '../assets/icon-d.webp';
import Logo from './Logo.astro';
const { website } = siteData;

const navLinks = [
    { href: '/catalog', label: 'Catálogo' },
    { href: '/financing', label: 'Financiación' },
    { href: '/quotation', label: 'Cotización' },
    { href: '/contact', label: 'Contacto' },
    { href: '/aboutUs', label: 'Historia' },
];
---

<header id="site-header" transition:persist class="sticky top-0 z-50 w-full bg-neutral-300/90 dark:bg-neutral-900/90 backdrop-blur-md shadow-sm border-b-2 border-secondary text-black dark:text-white">
    <div class="flex items-center justify-between gap-4 px-6 md:px-16 lg:px-30 py-4 lg:py-3">
        <a href="/" class="group flex items-center gap-2 shrink-0 hover:scale-105 focus-visible:scale-105 transition-transform duration-300" aria-label={website.name}>
            <Logo />
        </a>

        <nav class="hidden lg:flex items-center gap-8 uppercase font-bold text-sm tracking-widest" aria-label="Principal">
            {navLinks.map((link) => (
                <a href={link.href} class="hover:text-secondary/90 hover:scale-110 transition-all duration-300">{link.label}</a>
            ))}
        </nav>

        <div class="flex items-center gap-4 lg:hidden">
            <button type="button" id="mobile-menu-toggle" class="lg:hidden peer group inline-flex w-11 h-11 items-center justify-center rounded transition" aria-pressed="false">
                <span class="sr-only">Menu</span>
                <svg class="w-6 h-6 fill-current pointer-events-none" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                    <rect class="origin-center -translate-y-1.25 translate-x-1.75 transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.1)] group-aria-pressed:translate-x-0 group-aria-pressed:translate-y-0 group-aria-pressed:rotate-315" y="7" width="9" height="2" rx="1"></rect>
                    <rect class="origin-center transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.8)] group-aria-pressed:rotate-45" y="7" width="16" height="2" rx="1"></rect>
                    <rect class="origin-center translate-y-1.25 transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.1)] group-aria-pressed:translate-y-0 group-aria-pressed:rotate-[-225deg]" y="7" width="9" height="2" rx="1"></rect>
                </svg>
            </button>

            <ul id="mobile-menu" class="lg:hidden absolute left-0 right-0 top-full flex flex-col bg-neutral-400 dark:bg-black/95 backdrop-blur-md transition-transform duration-300 scale-y-0 origin-top peer-aria-pressed:scale-y-100">
                {navLinks.map((link) => (
                    <li>
                        <a href={link.href} class="block w-full px-6 py-4 font-bold uppercase tracking-wide hover:text-secondary focus:text-secondary hover:bg-white/5 focus:bg-white/5 transition-colors duration-300">{link.label}</a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</header>

<script>
    document.addEventListener('astro:page-load', () => {
        const header = document.getElementById('site-header');
        const menuToggle = document.getElementById('mobile-menu-toggle');
        const logoName = document.getElementById('navbar-logo-name');

        // El header persiste entre navegaciones (transition:persist) para no
        // recrearse en cada view transition, pero este script sí se vuelve a
        // ejecutar en cada 'astro:page-load' — sin esta guarda, el botón
        // (el mismo nodo del DOM en todas las páginas) terminaría con un
        // listener de click acumulado por cada navegación.
        if (menuToggle instanceof HTMLElement && !menuToggle.dataset.navBound) {
            menuToggle.dataset.navBound = 'true';
            menuToggle.addEventListener('click', () => {
                const isOpen = menuToggle.getAttribute('aria-pressed') === 'true';
                menuToggle.setAttribute('aria-pressed', String(!isOpen));

                // Dispara la misma animación de "el auto se levanta" del logo
                // que se ve en desktop al hacer hover, pero al abrir el menú.
                if (header instanceof HTMLElement) {
                    header.classList.toggle('menu-open', !isOpen);
                }

                if (logoName instanceof HTMLElement) {
                    if (!isOpen) {
                        // Se abre: mostrar y reproducir la animación de entrada.
                        logoName.classList.remove('hidden', 'animate-fade-out-left');
                        logoName.classList.add('flex', 'animate-fade-in-right');
                    } else {
                        // Se cierra: reproducir la animación de salida y recién
                        // ocultarlo (display: none) cuando termina.
                        logoName.classList.remove('animate-fade-in-right');
                        logoName.classList.add('flex', 'animate-fade-out-left');
                        logoName.addEventListener('animationend', () => {
                            logoName.classList.remove('flex', 'animate-fade-out-left');
                            logoName.classList.add('hidden');
                        }, { once: true });
                    }
                }
            });
        }
    });
</script>
