---
import Title from './Title.astro';
import siteData from '../data/data.json';

const { website } = siteData;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(website.mapsQuery || website.address)}&z=14&output=embed`;
---

<section id="ubicacion" class="mx-auto w-full max-w-7xl px-4 py-24 sm:px-8 sm:py-32">
	<div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
		<div class="flex flex-col justify-between gap-10 lg:col-span-5">
			<Title eyebrow="Ubicación" title="Te esperamos en Cipolletti." />
			<div data-anim="up" class="flex flex-col gap-6">
				<div>
					<p class="text-xs font-medium uppercase tracking-[0.25em] text-secondary/50">Dirección</p>
					<p class="mt-2 font-display text-xl font-semibold text-secondary">{website.address}</p>
				</div>
				<div>
					<p class="text-xs font-medium uppercase tracking-[0.25em] text-secondary/50">Visitas</p>
					<p class="mt-2 text-secondary/75">Coordiná una visita para conocer el salón y el parque por mensaje directo.</p>
				</div>
				<a
					href={website.ubication}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex w-fit items-center gap-2 rounded-full border border-secondary/25 px-6 py-3.5 text-sm font-medium text-secondary transition-colors hover:border-secondary"
				>
					Abrir en Google Maps
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0H8m9 0v9" /></svg>
				</a>
			</div>
		</div>

		<div data-anim="clip" class="overflow-hidden rounded-2xl bg-tertiary lg:col-span-7">
			<iframe
				src={mapSrc}
				title={`Mapa de ubicación de ${website.name}`}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				class="h-80 w-full border-0 grayscale-[35%] sm:h-[28rem]"
			></iframe>
		</div>
	</div>
</section>
