---
interface Props {
	hrefWhs: string;
	floating?: boolean;
	label?: string;
	id?: string;
	disabled?: boolean;
	inline?: boolean;
}

const { hrefWhs, floating = false, label = 'Consultar por WhatsApp', id, disabled = false, inline = false } = Astro.props;
---

<a
	id={id}
	href={hrefWhs}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={label}
	aria-disabled={disabled ? 'true' : undefined}
	class:list={[
		"group justify-center items-center text-center text-white transition-all duration-300",
		floating
			? "fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 flex flex-row items-center gap-2.5 w-14 h-14 sm:w-auto sm:h-auto p-0 sm:px-5 sm:py-3.5 bg-[#25D366] hover:bg-[#20bd5a] shadow-xl shadow-black/20 hover:scale-105 active:scale-95 border border-black/10"
			: "flex flex-row gap-2.5 px-5 py-3.5 bg-[#25D366] hover:bg-[#20bd5a] font-semibold text-sm hover:scale-105 active:scale-95 shadow-md",
		!floating && !inline && "mt-4 mx-auto",
		disabled && "pointer-events-none opacity-50"
	]}
>
	<!-- Ícono oficial de WhatsApp -->
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="currentColor"
		class:list={[
			"shrink-0",
			floating ? "w-8 h-8 sm:w-6 sm:h-6" : "w-5 h-5"
		]}
		aria-hidden="true"
	>
		<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15ZM16.56 14.41C16.31 14.29 15.1 13.69 14.88 13.61C14.65 13.53 14.49 13.49 14.32 13.73C14.16 13.98 13.69 14.53 13.55 14.69C13.4 14.86 13.26 14.88 13.01 14.75C12.77 14.63 11.98 14.37 11.05 13.54C10.32 12.89 9.83 12.09 9.69 11.84C9.54 11.6 9.67 11.46 9.8 11.34C9.91 11.23 10.04 11.05 10.17 10.91C10.29 10.76 10.33 10.66 10.41 10.49C10.5 10.33 10.45 10.19 10.39 10.06C10.33 9.94 9.84 8.74 9.63 8.25C9.43 7.77 9.23 7.84 9.08 7.83C8.94 7.82 8.77 7.82 8.61 7.82C8.45 7.82 8.18 7.88 7.96 8.13C7.73 8.37 7.1 8.96 7.1 10.17C7.1 11.38 7.98 12.54 8.1 12.71C8.23 12.87 9.84 15.36 12.31 16.42C12.9 16.67 13.35 16.82 13.71 16.94C14.3 17.12 14.84 17.1 15.26 17.03C15.74 16.96 16.73 16.43 16.94 15.84C17.14 15.26 17.14 14.76 17.08 14.66C17.02 14.56 16.81 14.53 16.56 14.41Z" />
	</svg>

	<!-- Texto oculto en mobile cuando es floating para que sea un solo botón circular limpio -->
	<span class:list={[
		"text-white font-semibold select-none",
		floating ? "hidden sm:inline text-sm" : "text-sm"
	]}>
		{label}
	</span>
</a>