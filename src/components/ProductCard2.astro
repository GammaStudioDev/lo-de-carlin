---
import { getImage } from 'astro:assets';
import siteData from '../data/data.json';

interface Props {
	product: {
		id: number;
		name: string;
		price: number;
		year: number;
		km: number;
		images: string[];
	};
	// False for the looping duplicate copies a Carousel renders alongside the
	// real card — giving those the same transition:name as the original would
	// produce duplicate view-transition-name values and silently break the
	// view transition for every copy.
	isPrimary?: boolean;
}

const { product, isPrimary = true } = Astro.props;
const { website } = siteData;
const imageTransitionName = isPrimary ? `product-image-${product.id}` : undefined;
const nameTransitionName = isPrimary ? `product-name-${product.id}` : undefined;
const priceTransitionName = isPrimary ? `product-price-${product.id}` : undefined;
const yearTransitionName = isPrimary ? `product-year-${product.id}` : undefined;
const kmTransitionName = isPrimary ? `product-km-${product.id}` : undefined;

// Cards render at ~240px on the catalog grid and up to 256px in the
// carousel — 480 covers both comfortably at 2x pixel density.
const cardImage = await getImage({ src: product.images[0], width: 480, height: 480, fit: 'cover', format: 'webp' });

const whatsappHref = `https://api.whatsapp.com/send?phone=${encodeURIComponent(website.telephone)}&text=${encodeURIComponent(`Hola! Quiero consultar por ${product.name}`)}`;
---

<article class:list={["flex flex-col h-full bg-white dark:bg-neutral-900 rounded-2xl overflow-hidden shadow-sm ring-1 ring-neutral-900/10 dark:ring-white/10"]}>
	<a href={`/productView/${product.id}`} class="block bg-neutral-100 dark:bg-neutral-800">
		<img
			src={cardImage.src}
			width="480"
			height="480"
			alt={product.name}
			loading="lazy"
			transition:name={imageTransitionName}
			class="w-full h-auto aspect-square object-cover"
		/>
	</a>
	<div class="flex flex-col flex-1 gap-1 p-4">
		<h3 class="text-sm md:text-base font-black uppercase text-neutral-950 dark:text-white line-clamp-1" transition:name={nameTransitionName}>{product.name}</h3>
		<div class="flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400">
			<div class="flex items-center gap-1">
				<svg class="w-3.5 h-3.5 shrink-0 fill-none stroke-secondary" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="4" width="18" height="18" rx="2" />
					<path d="M16 2v4M8 2v4M3 10h18" />
				</svg>
				<span transition:name={yearTransitionName}>{product.year}</span>
			</div>
			<div class="flex items-center gap-1">
				<svg class="w-3.5 h-3.5 shrink-0 fill-none stroke-secondary" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 20a8 8 0 1 0-8-8" />
					<path d="M12 12l3-3M4 20h16" />
				</svg>
				<span transition:name={kmTransitionName}>{product.km} km</span>
			</div>
		</div>
		<div class="mt-3 flex items-center gap-2">
			<a
				href={`/productView/${product.id}`}
				class="flex-1 inline-flex items-center justify-center rounded-lg bg-secondary/80 hover:bg-secondary text-white font-bold uppercase text-xs md:text-sm tracking-wide px-4 py-3 transition-colors duration-300"
			>
				Ver más
			</a>
			<a
				href={whatsappHref}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Consultar por WhatsApp"
				class="hidden lg:inline-flex items-center justify-center shrink-0 w-11 h-11 rounded-lg border border-neutral-900/15 dark:border-white/15 text-neutral-900 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-300"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 158 158" class="w-5 h-5" fill="none" aria-hidden="true">
					<path fill="currentColor" d="M130 74a50 50 0 0 0-50-46 50 50 0 0 0-42 76l-11 24 35-4a49 49 0 0 0 28 3c23-5 40-25 40-49zm-67 40-19 2 6-13-1-1-1-1q-7-11-7-23a40 40 0 0 1 79 0v1a40 40 0 0 1-56 35z" />
					<path fill="currentColor" d="M94 101c-20 0-36-16-36-37a9 9 0 0 1 13-8l1 1 2 13v1l-5 2v1q4 11 15 16h1v-1l3-4 14 2 1 5q-1 8-9 9" />
				</svg>
			</a>
		</div>
	</div>
</article>
