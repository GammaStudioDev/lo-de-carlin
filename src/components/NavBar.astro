---
import siteData from '../data/data.json';
import Logo from './Logo.astro';
const { website } = siteData;

const navLinks = [
    { href: '/#services', label: 'Propuestas' },
    { href: '/#comodidades', label: 'Comodidades' },
    { href: '/#menu', label: 'Gastronomía & Barra' },
    { href: '/aboutUs', label: 'El Espacio' },
    { href: '/contact', label: 'Contacto' },
];

const whatsappEventMessage = "¡Hola Malabar Eventos! Me gustaría consultar por disponibilidad y presupuesto para un evento en Tandil.";
const whatsappEventUrl = `https://api.whatsapp.com/send?phone=${encodeURIComponent(website.telephone)}&text=${encodeURIComponent(whatsappEventMessage)}`;
---

<header
    id="site-header"
    class="sticky top-0 z-50 text-black flex flex-col w-full bg-white/95 backdrop-blur-xl px-4 sm:px-8 lg:px-12 py-4 transition-all duration-300 border-b border-black/10"
>
    <!-- Fila superior: Logo y Navegación en un solo renglón sin desbordar -->
    <div class="flex justify-between items-center w-full max-w-7xl mx-auto min-h-[46px] gap-6 flex-nowrap">
        <a href="/" class="group flex items-center shrink-0 transition-opacity hover:opacity-80" aria-label={website.name}>
            <Logo />
        </a>

        <!-- Desktop Navigation: Sin bordes redondeados, fondo blanco, texto negro -->
        <nav class="hidden lg:flex items-center gap-6 xl:gap-8 shrink-0 flex-nowrap whitespace-nowrap" aria-label="Navegación principal">
            <ul class="flex items-center gap-6 xl:gap-8 flex-nowrap whitespace-nowrap">
                {navLinks.map((link) => (
                    <li class="shrink-0">
                        <a
                            href={link.href}
                            class="relative flex items-center justify-center font-medium text-xs xl:text-sm tracking-[0.2em] uppercase text-neutral-600 hover:text-black hover:border-b hover:border-black py-1 transition-all duration-200"
                        >
                            <span>{link.label}</span>
                        </a>
                    </li>
                ))}
            </ul>

            <a
                href={whatsappEventUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 whitespace-nowrap inline-flex items-center justify-center gap-2 border border-black bg-black hover:bg-white text-white hover:text-black font-semibold text-xs uppercase tracking-[0.2em] py-3 px-6 transition-all duration-300"
            >
                <span>Consultar Fecha</span>
            </a>
        </nav>

        <!-- Mobile Toggle Button -->
        <button
            type="button"
            id="mobile-menu-toggle"
            class="lg:hidden group inline-flex w-10 h-10 items-center justify-center border border-black/20 hover:border-black hover:bg-black/5 transition-colors focus-visible:outline-none shrink-0 text-black"
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
        >
            <span class="sr-only">Menu</span>
            <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="square" stroke-linejoin="miter" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
    </div>

    <!-- Mobile Navigation Menu -->
    <div
        id="mobile-menu-wrapper"
        class="w-full overflow-hidden transition-[max-height,opacity] duration-300 ease-in-out lg:hidden max-h-0 opacity-0 pointer-events-none"
    >
        <div class="w-full flex flex-col pt-4 mt-3 border-t border-black/10 max-w-7xl mx-auto bg-white">
            <ul class="flex flex-col items-start gap-3 w-full pb-4">
                {navLinks.map((link) => (
                    <li class="w-full">
                        <a
                            href={link.href}
                            class="flex items-center w-full py-2 text-sm font-medium tracking-[0.2em] uppercase text-neutral-700 hover:text-black hover:translate-x-1 transition-all"
                        >
                            <span>{link.label}</span>
                        </a>
                    </li>
                ))}
                <li class="w-full pt-2">
                    <a
                        href={whatsappEventUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full inline-flex items-center justify-center gap-2 border border-black bg-black hover:bg-white text-white hover:text-black font-bold text-xs uppercase tracking-[0.2em] py-3.5 px-4 transition-all text-center"
                    >
                        <span>Consultar Fecha</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

<script>
    document.addEventListener('astro:page-load', () => {
        const header = document.getElementById('site-header');
        const menuWrapper = document.getElementById('mobile-menu-wrapper');
        const menuToggle = document.getElementById('mobile-menu-toggle');

        if (menuToggle instanceof HTMLElement && header instanceof HTMLElement && menuWrapper instanceof HTMLElement) {
            menuToggle.addEventListener('click', () => {
                const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
                const nextState = !isExpanded;
                menuToggle.setAttribute('aria-expanded', String(nextState));

                if (nextState) {
                    header.classList.add('menu-open');
                    menuWrapper.classList.remove('max-h-0', 'opacity-0', 'pointer-events-none');
                    menuWrapper.classList.add('max-h-96', 'opacity-100', 'pointer-events-auto');
                } else {
                    header.classList.remove('menu-open');
                    menuWrapper.classList.remove('max-h-96', 'opacity-100', 'pointer-events-auto');
                    menuWrapper.classList.add('max-h-0', 'opacity-0', 'pointer-events-none');
                }
            });
        }
    });
</script>