---
import siteData from '../data/data.json';
import Logo from './Logo.astro';
const { website } = siteData;

const navLinks = [
	{ href: '/espacios', label: 'Espacios' },
	{ href: '/eventos', label: 'Eventos' },
	{ href: '/galeria', label: 'Galería' },
	{ href: '/nosotros', label: 'Nosotros' },
	{ href: '/contacto', label: 'Contacto' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href === '/eventos' && path.startsWith('/productView'));
---

<header id="site-header" class="sticky top-0 z-50 w-full bg-main/85 backdrop-blur-lg border-b border-secondary/10">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-8">
		<a href="/" class="shrink-0 transition-opacity hover:opacity-80" aria-label={`${website.name} — inicio`}>
			<Logo />
		</a>

		<nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
			<ul class="flex items-center gap-8">
				{navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? 'page' : undefined}
							class="group relative py-1 text-sm font-medium text-secondary/70 transition-colors hover:text-secondary aria-[current=page]:text-secondary"
						>
							{link.label}
							<span class="absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 bg-secondary transition-transform duration-500 group-hover:scale-x-100 group-aria-[current=page]:scale-x-100"></span>
						</a>
					</li>
				))}
			</ul>
			<a
				href="/reservar"
				data-magnetic
				aria-current={isActive('/reservar') ? 'page' : undefined}
				class="rounded-full bg-secondary px-5 py-2.5 text-sm font-medium text-main transition-opacity hover:opacity-85"
			>
				Reservar
			</a>
		</nav>

		<button
			type="button"
			id="mobile-menu-toggle"
			class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-full border border-secondary/20 text-secondary"
			aria-label="Abrir menú"
			aria-expanded="false"
			aria-controls="mobile-menu-wrapper"
		>
			<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" d="M4 8h16M4 16h16" />
			</svg>
		</button>
	</div>

	<div id="mobile-menu-wrapper" class="lg:hidden grid grid-rows-[0fr] transition-[grid-template-rows] duration-300">
		<div class="overflow-hidden">
			<ul class="mx-auto flex max-w-7xl flex-col gap-1 px-4 pb-5 sm:px-8">
				{navLinks.map((link) => (
					<li>
						<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class="mobile-link block border-b border-secondary/10 py-3 font-display text-2xl font-bold text-secondary/80 aria-[current=page]:text-secondary">
							{link.label}
						</a>
					</li>
				))}
				<li class="pt-4">
					<a
						href="/reservar"
						class="mobile-link block rounded-full bg-secondary py-3.5 text-center text-sm font-semibold text-main"
					>
						Reservar fecha
					</a>
				</li>
			</ul>
		</div>
	</div>
</header>

<script>
	document.addEventListener('astro:page-load', () => {
		const toggle = document.getElementById('mobile-menu-toggle');
		const menu = document.getElementById('mobile-menu-wrapper');
		if (!toggle || !menu) return;

		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			menu.classList.toggle('grid-rows-[1fr]', open);
			menu.classList.toggle('grid-rows-[0fr]', !open);
		};

		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
		menu.querySelectorAll('.mobile-link').forEach((a) => a.addEventListener('click', () => setOpen(false)));
	});
</script>
