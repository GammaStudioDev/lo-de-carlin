---
import siteData from '../data/data.json';
import productsData from '../data/products.json';

const { website } = siteData;
const words = ['cumpleaños', 'casamiento', 'aniversario', 'capacitación', 'evento'];
const services = productsData.products.slice(0, 4).map((p) => p.name);
---

<section data-hero class="relative w-full overflow-hidden">
	<div class="mx-auto grid min-h-[calc(100svh-4.3rem)] max-w-7xl items-center gap-10 px-4 py-8 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:py-10">
		<!-- Texto -->
		<div class="relative z-10 lg:col-span-6">
			<p data-hero-fade class="mb-5 inline-flex items-center gap-2 rounded-full border border-secondary/15 bg-tertiary/60 px-3.5 py-1.5 text-[11px] font-medium uppercase tracking-[0.22em] text-secondary/70">
				<span class="relative flex h-2 w-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-secondary/40"></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-secondary"></span>
				</span>
				Salón de eventos · {website.city}
			</p>

			<h1 class="font-display text-[2.75rem] font-extrabold leading-[0.95] tracking-tight text-secondary sm:text-7xl lg:text-6xl xl:text-[4.75rem]">
				<span data-hero-line class="block overflow-hidden pb-1"><span class="block">Tu</span></span>
				<span data-hero-line class="block overflow-hidden pb-2">
					<span class="block">
						<span data-rotator class="relative inline-grid overflow-hidden align-bottom text-secondary/45">
							{words.map((w, i) => (
								<span data-word class:list={['col-start-1 row-start-1 whitespace-nowrap', i > 0 && 'opacity-0']}>{w}</span>
							))}
						</span>
					</span>
				</span>
				<span data-hero-line class="block overflow-hidden pb-1"><span class="block">en lo de Carlin.</span></span>
			</h1>

			<p data-hero-fade class="mt-6 max-w-md text-base leading-relaxed text-secondary/70 sm:text-lg">
				Salón amplio, parque lleno de verde y catering. Vos elegís qué festejar, nosotros te damos el lugar.
			</p>

			<div data-hero-fade class="mt-8 flex flex-wrap items-center gap-3">
				<a
					href="/reservar"
					data-magnetic
					class="group inline-flex items-center gap-3 rounded-full bg-secondary py-2 pl-6 pr-2 text-sm font-semibold text-main shadow-lg shadow-secondary/20 transition-shadow hover:shadow-xl hover:shadow-secondary/30"
				>
					Reservar fecha
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-main text-secondary transition-transform duration-500 group-hover:rotate-[-45deg]">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
					</span>
				</a>
				<a
					href="/espacios"
					data-magnetic
					class="inline-flex items-center rounded-full border border-secondary/25 px-6 py-[1.05rem] text-sm font-semibold text-secondary transition-colors hover:border-secondary hover:bg-secondary/5"
				>
					Conocer el lugar
				</a>
			</div>

			<ul data-hero-fade class="mt-10 hidden flex-wrap gap-x-6 gap-y-2 text-sm text-secondary/55 sm:flex">
				{services.map((s) => (
					<li class="inline-flex items-center gap-2"><span class="h-1 w-1 rounded-full bg-secondary/40"></span>{s}</li>
				))}
			</ul>
		</div>

		<!-- Composición de imágenes -->
		<div class="relative h-[19rem] sm:h-[28rem] lg:col-span-6 lg:h-[36rem]">
			<div data-depth="-18" class="absolute right-0 top-0 h-[88%] w-[78%]">
				<div data-hero-img class="h-full w-full overflow-hidden rounded-[1.25rem]">
					<img src="/images/lodecarlin/salon-exterior.jpg" alt="Frente del salón Lo de Carlin entre álamos" width="563" height="532" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
				</div>
			</div>
			<div data-depth="28" class="absolute bottom-0 left-0 h-[48%] w-[44%]">
				<div data-hero-img class="h-full w-full overflow-hidden rounded-[1.25rem] ring-8 ring-main">
					<img src="/images/lodecarlin/catering.jpg" alt="Mesa dulce de un evento" width="528" height="463" loading="eager" class="h-full w-full object-cover" />
				</div>
			</div>
			<div data-depth="12" class="absolute bottom-[6%] right-[4%] hidden sm:block">
				<div data-hero-img class="overflow-hidden rounded-2xl bg-main/90 px-5 py-4 shadow-xl shadow-black/10 backdrop-blur">
					<p class="font-display text-3xl font-extrabold text-secondary">Salón + Parque</p>
					<p class="text-xs uppercase tracking-[0.2em] text-secondary/55">Todo en un mismo lugar</p>
				</div>
			</div>

			<!-- Sello giratorio -->
			<a href={website.instagramDM} target="_blank" rel="noopener noreferrer" aria-label="Reservas por mensaje directo" data-hero-pop data-depth="40" class="absolute left-[30%] top-[2%] flex h-28 w-28 items-center justify-center rounded-full bg-secondary text-main sm:h-32 sm:w-32 lg:left-[8%] lg:top-[10%]">
				<svg data-spin="16" viewBox="0 0 100 100" class="absolute inset-0 h-full w-full" aria-hidden="true">
					<defs><path id="circle-path" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" /></defs>
					<text class="fill-current text-[9px] font-semibold uppercase">
						<textPath href="#circle-path" textLength="230" lengthAdjust="spacing">Reservas por MD · Reservas por MD · </textPath>
					</text>
				</svg>
				<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0H8m9 0v9" /></svg>
			</a>
		</div>
	</div>

</section>
