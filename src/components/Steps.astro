---
import Title from './Title.astro';

const steps = [
	{ title: 'Completá el cuestionario', text: 'Contanos qué querés festejar, la fecha y cuántos invitados esperás. Lleva un minuto.' },
	{ title: 'Envianos el mensaje', text: 'Tu resumen se copia solo y te lleva a nuestro Instagram para mandarlo por MD.' },
	{ title: 'Coordinamos la visita', text: 'Te respondemos con disponibilidad y propuestas, y si querés conocés el lugar.' },
];
---

<section class="mx-auto w-full max-w-7xl px-4 py-24 sm:px-8 sm:py-32">
	<Title eyebrow="Cómo reservar" title="Tres pasos y tu fecha queda en marcha." />
	<ol data-anim-stagger class="mt-16 grid gap-px overflow-hidden rounded-[1.25rem] bg-secondary/10 md:grid-cols-3">
		{steps.map((step, i) => (
			<li data-anim="up" class="group bg-main p-8 transition-colors duration-500 hover:bg-secondary hover:text-main sm:p-10">
				<span class="text-outline font-display text-6xl font-extrabold leading-none transition-all group-hover:[-webkit-text-stroke-color:var(--color-main-value)]">0{i + 1}</span>
				<h3 class="mt-8 font-display text-2xl font-bold tracking-tight">{step.title}</h3>
				<p class="mt-3 leading-relaxed opacity-70">{step.text}</p>
			</li>
		))}
	</ol>
</section>
